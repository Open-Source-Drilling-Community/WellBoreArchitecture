<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<RootNamespace>OSDC.Drilling.WellBoreArchitecture.WebPages</RootNamespace>
		<AssemblyName>OSDC.Drilling.WellBoreArchitecture.WebPages</AssemblyName>
		<PackageId>OSDC.Drilling.WellBoreArchitecture.WebPages</PackageId>
		<Title>OSDC.Drilling.WellBoreArchitecture.WebPages</Title>
		<Authors>Eric Cayeux</Authors>
		<Company>NORCE</Company>
		<Description>Reusable Razor class library containing the WellBoreArchitecture editor pages, dependent components, and helper utilities. See the package README for setup, dependencies, and usage.</Description>
		<PackageTags>wellborearchitecture;drilling;blazor;razor;mudblazor;plotly</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Open-Source-Drilling-Community/WellBoreArchitecture</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/Open-Source-Drilling-Community/WellBoreArchitecture</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Version>1.1.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MudBlazor" Version="9.6.0" />
		<PackageReference Include="OSDC.DotnetLibraries.Drilling.WebAppUtils" Version="1.1.3" />
		<PackageReference Include="Plotly.Blazor" Version="6.0.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Include generated DTO source files directly from ModelSharedOut -->
	<ItemGroup>
		<Compile Include="..\ModelSharedOut\WellBoreArchitectureMergedModel.cs" Link="GeneratedDtos\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\ModelSharedOut\PseudoConstructors.cs" Link="GeneratedDtos\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
