@page "/StatisticsWellBoreArchitecture"
@inject ILogger<StatisticsWellBoreArchitecture> logger
@inject ISnackbar Snackbar
@inject IWellBoreArchitectureAPIUtils Api

@if (statistics_ == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div hidden="@isHiddenMainPanel">
        <MudText Class="mt-4 mb-4" Typo="Typo.h5"><strong>Usage Statistics</strong></MudText>
        <div style="width: 90%; margin: auto">
            <MudGrid>
                <MudItem xs="6">
                    <MudText Typo="Typo.h6">Total count:</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body1">@totalCount_</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.h6">Well-bore architecture count:</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.body1">@wellBoreArchitectureCount_</MudText>
                </MudItem>
            </MudGrid>
        </div>
    </div>
}

@code {
    private UsageStatisticsWellBoreArchitecture statistics_ = null!;
    private long totalCount_ = 0;
    private long wellBoreArchitectureCount_ = 0;

    private bool isHiddenMainPanel = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statistics_ = await Api.ClientWellBoreArchitecture.GetWellBoreArchitectureUsageStatisticsAsync();
            if (statistics_ != null)
            {
                totalCount_ = 0;
                wellBoreArchitectureCount_ = 0;

                if (statistics_.GetAllWellBoreArchitectureIdPerDay != null && statistics_.GetAllWellBoreArchitectureIdPerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.GetAllWellBoreArchitectureIdPerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.GetAllWellBoreArchitectureMetaInfoPerDay != null && statistics_.GetAllWellBoreArchitectureMetaInfoPerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.GetAllWellBoreArchitectureMetaInfoPerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.GetWellBoreArchitectureByIdPerDay != null && statistics_.GetWellBoreArchitectureByIdPerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.GetWellBoreArchitectureByIdPerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.GetAllWellBoreArchitectureLightPerDay != null && statistics_.GetAllWellBoreArchitectureLightPerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.GetAllWellBoreArchitectureLightPerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.GetAllWellBoreArchitecturePerDay != null && statistics_.GetAllWellBoreArchitecturePerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.GetAllWellBoreArchitecturePerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.PostWellBoreArchitecturePerDay != null && statistics_.PostWellBoreArchitecturePerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.PostWellBoreArchitecturePerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.PutWellBoreArchitectureByIdPerDay != null && statistics_.PutWellBoreArchitectureByIdPerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.PutWellBoreArchitectureByIdPerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
                if (statistics_.DeleteWellBoreArchitectureByIdPerDay != null && statistics_.DeleteWellBoreArchitectureByIdPerDay.Data != null)
                {
                    foreach (CountPerDay count in statistics_.DeleteWellBoreArchitectureByIdPerDay.Data)
                    {
                        totalCount_ += (long)count.Count;
                        wellBoreArchitectureCount_ += (long)count.Count;
                    }
                }
            }

            isHiddenMainPanel = false;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Problem UsageStatistics initialization");
            Snackbar.Add("Failed to load usage statistics.", Severity.Error);
        }

        await InvokeAsync(() => { StateHasChanged(); });
    }
}
