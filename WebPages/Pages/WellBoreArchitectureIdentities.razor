@page "/WellBoreArchitectureIdentities"
@inject IWellBoreArchitectureAPIUtils Api
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">WellBore Architecture Identities</MudText>
<MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Add">Add identity</MudButton>
<MudButton Color="Color.Primary" Variant="Variant.Filled" Class="ml-2" OnClick="SaveAsync">Save</MudButton>
<MudTable Items="items" Dense="true" Hover="true" Class="mt-4">
    <HeaderContent><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd><MudTextField @bind-Value="context.Name" /></MudTd>
        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" /></MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<WellBoreArchitectureIdentity> items = [];
    protected override async Task OnInitializedAsync() => items = await Api.ClientWellBoreArchitecture.GetAllWellBoreArchitectureIdentityAsync();
    private void Add() => items.Add(new() { MetaInfo = new() { ID = Guid.NewGuid() } });
    private async Task SaveAsync()
    {
        var existing = (await Api.ClientWellBoreArchitecture.GetAllWellBoreArchitectureIdentityIdAsync()).ToHashSet();
        foreach (var item in items)
            if (existing.Contains(item.MetaInfo.ID)) await Api.ClientWellBoreArchitecture.PutWellBoreArchitectureIdentityByIdAsync(item.MetaInfo.ID, item.LastModificationDate, item);
            else await Api.ClientWellBoreArchitecture.PostWellBoreArchitectureIdentityAsync(item);
        items = await Api.ClientWellBoreArchitecture.GetAllWellBoreArchitectureIdentityAsync();
        Snackbar.Add("Identities saved", Severity.Success);
    }
    private async Task DeleteAsync(WellBoreArchitectureIdentity item)
    {
        if (item.LastModificationDate == null) { items.Remove(item); return; }
        try { await Api.ClientWellBoreArchitecture.DeleteWellBoreArchitectureIdentityByIdAsync(item.MetaInfo.ID, item.LastModificationDate); items.Remove(item); }
        catch (ApiException ex) when (ex.StatusCode == 409) { Snackbar.Add("This identity is in use and cannot be deleted.", Severity.Warning); }
    }
}
