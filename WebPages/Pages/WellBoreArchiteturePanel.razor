            logger.LogWarning(ex, "Impossible to resolve Well details for well id {WellId}", wellId.Value);
            return null;
        }
    }

    private async Task<Cluster?> ResolveClusterAsync(Guid? clusterId)
    {
        if (!clusterId.HasValue || clusterId == Guid.Empty)
        {
