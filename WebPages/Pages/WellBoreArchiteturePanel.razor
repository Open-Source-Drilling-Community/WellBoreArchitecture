    private List<CasingSection> EnsureCasingSectionsList()
    {
        if (WellBoreArchitecture == null)
        {
            return new List<CasingSection>();
        }

        if (WellBoreArchitecture.CasingSections is not List<CasingSection> list)
        {
            list = WellBoreArchitecture.CasingSections?.ToList() ?? new List<CasingSection>();
            WellBoreArchitecture.CasingSections = list;
        }

        if (list.Count == 0)
        {
            list.Add(CreateDefaultCasingSection());
        }

        foreach (var section in list)
        {
            EnsureCasingSectionElement(section);
            EnsureCasingSectionSizeTable(section);
        }

        return list;
    }

    private static CasingSection CreateDefaultCasingSection()
    {
        return new CasingSection
        {
            TopDepth = ConversionsFromOSDC.DoubleToGaussian(null),
            Length = ConversionsFromOSDC.DoubleToGaussian(null),
            TopCementDepth = ConversionsFromOSDC.DoubleToGaussian(null),
            CasingSectionElements = new List<CasingSectionElement> { CreateDefaultCasingSectionElement() },
            CasingSectionSizeTable = new List<BoreHoleSize> { CreateDefaultCasingSectionSizeRow() },
            OpenHoleSection = null
        };
    }

    private static BoreHoleSize CreateDefaultCasingSectionSizeRow()
    {
        return new BoreHoleSize
        {
            HoleSize = ConversionsFromOSDC.DoubleToGaussian(null),
            Length = ConversionsFromOSDC.DoubleToGaussian(null)
        };
    }

    private static CasingSectionElement CreateDefaultCasingSectionElement()
    {
        return new CasingSectionElement
        {
            BodyOD = ConversionsFromOSDC.DoubleToGaussian(null),
            BodyID = ConversionsFromOSDC.DoubleToGaussian(null),
            CollarOD = ConversionsFromOSDC.DoubleToGaussian(null),
            JointLength = ConversionsFromOSDC.DoubleToGaussian(null),
            SectionLength = ConversionsFromOSDC.DoubleToGaussian(null)
        };
    }

    private static CasingSectionElement EnsureCasingSectionElement(CasingSection section)
    {
        if (section.CasingSectionElements is not List<CasingSectionElement> elements)
        {
            elements = section.CasingSectionElements?.ToList() ?? new List<CasingSectionElement>();
            section.CasingSectionElements = elements;
        }

        if (elements.Count == 0)
        {
            elements.Add(CreateDefaultCasingSectionElement());
        }

        return elements[0];
    }

    private static void EnsureCasingSectionSizeTable(CasingSection section)
    {
        if (section.CasingSectionSizeTable is not List<BoreHoleSize> rows)
        {
            rows = section.CasingSectionSizeTable?.ToList() ?? new List<BoreHoleSize>();
            section.CasingSectionSizeTable = rows;
        }

        if (rows.Count == 0)
        {
            rows.Add(CreateDefaultCasingSectionSizeRow());
        }
    }

    private void EnsureOpenHoleAttachedToLastCasing()
    {
        var casingSections = WellBoreArchitecture?.CasingSections?.ToList();
        if (casingSections == null || casingSections.Count == 0)
        {
            return;
        }
        var retainedOpenHole = casingSections.Select(section => section.OpenHoleSection).LastOrDefault(section => section != null) ?? CreateDefaultOpenHoleSection();
        foreach (var section in casingSections)
        {
            section.OpenHoleSection = null;
        }

        casingSections[^1].OpenHoleSection = retainedOpenHole;
        WellBoreArchitecture!.CasingSections = casingSections;
    }

    private static OpenHoleSection CreateDefaultOpenHoleSection()
    {
        return new OpenHoleSection
        {
            HoleSizes = new List<BoreHoleSize> { CreateDefaultOpenHoleRow() }
        };
    }

    private static BoreHoleSize CreateDefaultOpenHoleRow()
    {
        return new BoreHoleSize
        {
            HoleSize = ConversionsFromOSDC.DoubleToGaussian(null),
            Length = ConversionsFromOSDC.DoubleToGaussian(null)
        };
    }

    private List<BoreHoleSize> EnsureOpenHoleRows()
    {
        EnsureOpenHoleAttachedToLastCasing();
        var lastCasing = EnsureCasingSectionsList().Last();
        lastCasing.OpenHoleSection ??= CreateDefaultOpenHoleSection();
        if (lastCasing.OpenHoleSection.HoleSizes is not List<BoreHoleSize> rows)
        {
            rows = lastCasing.OpenHoleSection.HoleSizes?.ToList() ?? new List<BoreHoleSize>();
            lastCasing.OpenHoleSection.HoleSizes = rows;
        }

        if (rows.Count == 0)
        {
            rows.Add(CreateDefaultOpenHoleRow());
        }

        return rows;
    }

    private List<SimplifiedCasingRow> EnsureSimplifiedCasingRows()
    {
        if (_simplifiedCasingRows.Count == 0)
        {
            _simplifiedCasingRows = BuildSimplifiedRowsFromDetailedSections();
        }

        if (_simplifiedCasingRows.Count == 0)
        {
            _simplifiedCasingRows.Add(CreateDefaultSimplifiedCasingRow());
        }

        return _simplifiedCasingRows;
    }

    private List<SimplifiedCasingRow> BuildSimplifiedRowsFromDetailedSections()
    {
        var rows = new List<SimplifiedCasingRow>();
        foreach (var section in EnsureCasingSectionsList())
        {
            var sectionTop = GetGaussianValue(section.TopDepth) ?? 0.0;
            var sectionLength = GetGaussianValue(section.Length) ?? 0.0;
            var elements = section.CasingSectionElements?.ToList() ?? new List<CasingSectionElement>();
            var sizeRows = (section.CasingSectionSizeTable?.ToList() ?? new List<BoreHoleSize>())
                .Where(IsMeaningfulBoreHoleSizeRow)
                .ToList();

            if (elements.Count == 0 && sizeRows.Count == 0)
            {
                rows.Add(new SimplifiedCasingRow
                {
                    SuspensionDepth = sectionTop,
                    FinalDepth = sectionTop + sectionLength,
                    HasCement = GetGaussianValue(section.TopCementDepth) is double topCementDepthFallback && topCementDepthFallback <= sectionTop + CasingGroupingTolerance
                });
                continue;
            }

            var intervalEnds = new HashSet<double> { sectionTop, sectionTop + sectionLength };
            AddIntervalBoundaries(intervalEnds, sectionTop, sectionLength, elements.Select(element => GetGaussianValue(element.SectionLength)));
            AddIntervalBoundaries(intervalEnds, sectionTop, sectionLength, sizeRows.Select(row => GetGaussianValue(row.Length)));
            var topCementDepth = GetGaussianValue(section.TopCementDepth);
            if (topCementDepth.HasValue
                && topCementDepth.Value > sectionTop + CasingGroupingTolerance
                && topCementDepth.Value < sectionTop + sectionLength - CasingGroupingTolerance)
            {
                intervalEnds.Add(topCementDepth.Value);
            }

            var boundaries = intervalEnds
                .Where(boundary => boundary >= sectionTop - CasingGroupingTolerance && boundary <= sectionTop + sectionLength + CasingGroupingTolerance)
                .Distinct()
                .OrderBy(boundary => boundary)
                .ToList();

            if (boundaries.Count < 2)
            {
                rows.Add(new SimplifiedCasingRow
                {
                    SuspensionDepth = sectionTop,
                    FinalDepth = sectionTop + sectionLength,
                    OD = GetGaussianValue(elements.FirstOrDefault()?.BodyOD),
                    ID = GetGaussianValue(elements.FirstOrDefault()?.BodyID),
                    BoreholeOD = GetGaussianValue(sizeRows.FirstOrDefault()?.HoleSize),
                    HasCement = GetGaussianValue(section.TopCementDepth) is double topCementDepthFallback && topCementDepthFallback <= sectionTop + CasingGroupingTolerance
                });
                continue;
            }

            for (var i = 0; i < boundaries.Count - 1; i++)
            {
                var intervalTop = boundaries[i];
                var intervalBottom = boundaries[i + 1];
                if (intervalBottom - intervalTop <= CasingGroupingTolerance)
                {
                    continue;
                }

                var intervalProbeDepth = intervalTop + ((intervalBottom - intervalTop) / 2.0);
                var element = GetSectionElementAtDepth(elements, sectionTop, sectionLength, intervalProbeDepth);
                var sizeRow = GetBoreHoleSizeAtDepth(sizeRows, sectionTop, sectionLength, intervalProbeDepth);
                rows.Add(new SimplifiedCasingRow
                {
                    SuspensionDepth = intervalTop,
                    FinalDepth = intervalBottom,
                    OD = GetGaussianValue(element?.BodyOD),
                    ID = GetGaussianValue(element?.BodyID),
                    BoreholeOD = GetGaussianValue(sizeRow?.HoleSize),
                    HasCement = topCementDepth.HasValue && intervalTop >= topCementDepth.Value - CasingGroupingTolerance
                });
            }
        }

        return rows;
    }

    private void ApplySimplifiedRowsToDetailedSections()
    {
        var rows = EnsureSimplifiedCasingRows()
            .Select(row => row with { })
            .ToList();

        if (rows.Count == 0)
        {
            rows.Add(CreateDefaultSimplifiedCasingRow());
        }

        var retainedOpenHole = EnsureCasingSectionsList()
            .Select(section => section.OpenHoleSection)
            .LastOrDefault(section => section != null) ?? CreateDefaultOpenHoleSection();

        var detailedSections = new List<CasingSection>();
        CasingSection? currentSection = null;
        double? currentEnd = null;

        foreach (var row in rows)
        {
            var rowStart = row.SuspensionDepth ?? 0.0;
            var rowEnd = Math.Max(rowStart, row.FinalDepth ?? rowStart);
            var rowLength = rowEnd - rowStart;

            if (currentSection == null || currentEnd == null || Math.Abs(rowStart - currentEnd.Value) > CasingGroupingTolerance)
            {
                currentSection = CreateDefaultCasingSection();
                currentSection.TopDepth = ConversionsFromOSDC.DoubleToGaussian(rowStart);
                currentSection.Length = ConversionsFromOSDC.DoubleToGaussian(rowLength);
                currentSection.CasingSectionElements = new List<CasingSectionElement>();
                currentSection.CasingSectionSizeTable = new List<BoreHoleSize>();
                detailedSections.Add(currentSection);
            }
            else
            {
                var sectionTop = GetGaussianValue(currentSection.TopDepth) ?? rowStart;
                currentSection.Length = ConversionsFromOSDC.DoubleToGaussian(rowEnd - sectionTop);
            }

            AppendOrExtendCasingElement(currentSection!, row.OD, row.ID, rowLength);
            AppendOrExtendBoreHoleSize(currentSection, row.BoreholeOD, rowLength);
            currentEnd = rowEnd;
        }

        foreach (var section in detailedSections)
        {
            section.OpenHoleSection = null;
        }

        var groupedRows = BuildSimplifiedCasingGroups(rows);
        for (var i = 0; i < detailedSections.Count; i++)
        {
            var group = i < groupedRows.Count ? groupedRows[i] : null;
            var topCementDepth = group?.Rows
                .Where(row => row.HasCement)
                .Select(row => row.SuspensionDepth)
                .Where(value => value.HasValue)
                .Select(value => value!.Value)
                .Cast<double?>()
                .Min();

            detailedSections[i].TopCementDepth = topCementDepth.HasValue
                ? ConversionsFromOSDC.DoubleToGaussian(topCementDepth.Value)
                : ConversionsFromOSDC.DoubleToGaussian(null);
        }

        detailedSections[^1].OpenHoleSection = retainedOpenHole;
        WellBoreArchitecture!.CasingSections = detailedSections;
    }

    private static SimplifiedCasingRow CreateDefaultSimplifiedCasingRow()
    {
        return new SimplifiedCasingRow
        {
            SuspensionDepth = 0.0,
            FinalDepth = 0.0
        };
    }

    private static void AddIntervalBoundaries(HashSet<double> boundaries, double sectionTop, double sectionLength, IEnumerable<double?> lengths)
    {
        var cursor = sectionTop;
        foreach (var length in lengths)
        {
            var safeLength = Math.Max(0.0, length ?? 0.0);
            if (safeLength <= 0.0)
            {
                continue;
            }

            cursor = Math.Min(sectionTop + sectionLength, cursor + safeLength);
            boundaries.Add(cursor);
            if (cursor >= sectionTop + sectionLength - CasingGroupingTolerance)
            {
                break;
            }
        }
    }

    private static CasingSectionElement? GetSectionElementAtDepth(List<CasingSectionElement> elements, double sectionTop, double sectionLength, double depth)
    {
        if (elements.Count == 0)
        {
            return null;
        }

        var boundedDepth = Math.Min(sectionTop + sectionLength, Math.Max(sectionTop, depth));
        var cursor = sectionTop;
        var remaining = sectionLength;
        for (var i = 0; i < elements.Count; i++)
        {
            var element = elements[i];
            var segmentLength = GetSegmentLength(GetGaussianValue(element.SectionLength), remaining, elements.Count - i);
            var nextCursor = cursor + segmentLength;
            if (boundedDepth <= nextCursor + CasingGroupingTolerance || i == elements.Count - 1)
            {
                return element;
            }

            cursor = nextCursor;
            remaining = Math.Max(0.0, sectionTop + sectionLength - cursor);
        }

        return elements[^1];
    }

    private static BoreHoleSize? GetBoreHoleSizeAtDepth(List<BoreHoleSize> rows, double sectionTop, double sectionLength, double depth)
    {
        if (rows.Count == 0)
        {
            return null;
        }

        var boundedDepth = Math.Min(sectionTop + sectionLength, Math.Max(sectionTop, depth));
        var cursor = sectionTop;
        var remaining = sectionLength;
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var segmentLength = GetSegmentLength(GetGaussianValue(row.Length), remaining, rows.Count - i);
            var nextCursor = cursor + segmentLength;
            if (boundedDepth <= nextCursor + CasingGroupingTolerance || i == rows.Count - 1)
            {
                return row;
            }

            cursor = nextCursor;
            remaining = Math.Max(0.0, sectionTop + sectionLength - cursor);
        }

        return rows[^1];
    }

    private static double GetSegmentLength(double? requestedLength, double remaining, int segmentsRemaining)
    {
        if (requestedLength.HasValue && requestedLength.Value > 0.0)
        {
            return Math.Max(0.0, requestedLength.Value);
        }

        if (segmentsRemaining <= 1)
        {
            return Math.Max(0.0, remaining);
        }

        return Math.Max(0.0, remaining / Math.Max(1, segmentsRemaining));
    }

    private static void AppendOrExtendCasingElement(CasingSection section, double? od, double? id, double rowLength)
    {
        if (section.CasingSectionElements is not List<CasingSectionElement> elements)
        {
            elements = section.CasingSectionElements?.ToList() ?? new List<CasingSectionElement>();
            section.CasingSectionElements = elements;
        }

        var last = elements.LastOrDefault();
        if (last != null && AreClose(GetGaussianValue(last.BodyOD), od) && AreClose(GetGaussianValue(last.BodyID), id))
        {
            var existingLength = GetGaussianValue(last.SectionLength) ?? 0.0;
            last.SectionLength = ConversionsFromOSDC.DoubleToGaussian(existingLength + rowLength);
            return;
        }

        var element = CreateDefaultCasingSectionElement();
        element.BodyOD = ConversionsFromOSDC.DoubleToGaussian(od);
        element.BodyID = ConversionsFromOSDC.DoubleToGaussian(id);
        element.SectionLength = ConversionsFromOSDC.DoubleToGaussian(rowLength);
        elements.Add(element);
    }

    private static void AppendOrExtendBoreHoleSize(CasingSection section, double? boreholeOd, double rowLength)
    {
        if (!boreholeOd.HasValue || boreholeOd.Value <= 0.0)
        {
            return;
        }

        if (section.CasingSectionSizeTable is not List<BoreHoleSize> rows)
        {
            rows = section.CasingSectionSizeTable?.ToList() ?? new List<BoreHoleSize>();
            section.CasingSectionSizeTable = rows;
        }

        var last = rows.LastOrDefault();
        if (last != null && AreClose(GetGaussianValue(last.HoleSize), boreholeOd))
        {
            var existingLength = GetGaussianValue(last.Length) ?? 0.0;
            last.Length = ConversionsFromOSDC.DoubleToGaussian(existingLength + rowLength);
            return;
        }

        var row = CreateDefaultCasingSectionSizeRow();
        row.HoleSize = ConversionsFromOSDC.DoubleToGaussian(boreholeOd);
        row.Length = ConversionsFromOSDC.DoubleToGaussian(rowLength);
        rows.Add(row);
    }

    private static bool AreClose(double? a, double? b)
    {
        if (!a.HasValue && !b.HasValue)
        {
            return true;
        }

        if (!a.HasValue || !b.HasValue)
        {
            return false;
        }

        return Math.Abs(a.Value - b.Value) <= 1e-6;
    }

    private static bool IsMeaningfulBoreHoleSizeRow(BoreHoleSize? row)
    {
        return row != null
            && (GetGaussianValue(row.HoleSize).HasValue || GetGaussianValue(row.Length).HasValue);
    }

    private void AddCasingSection()
    {
        SimplifiedCasingRows.Add(CreateDefaultSimplifiedCasingRow());
        StateHasChanged();
    }

    private void RemoveCasingSection(int index)
    {
        if (SimplifiedCasingRows.Count == 1)
        {
            return;
        }

        SimplifiedCasingRows.RemoveAt(index);
        StateHasChanged();
    }

    private void MoveCasingSection(int index, int delta)
    {
        var list = SimplifiedCasingRows;
        var newIndex = index + delta;
        if (newIndex < 0 || newIndex >= list.Count)
        {
            return;
        }

        var item = list[index];
        list.RemoveAt(index);
        list.Insert(newIndex, item);
        StateHasChanged();
    }

    private void UpdateCasingSuspensionDepth(int index, double? value)
    {
        SimplifiedCasingRows[index].SuspensionDepth = value;
    }

    private void UpdateCasingFinalDepth(int index, double? value)
    {
        SimplifiedCasingRows[index].FinalDepth = value;
    }

    private void UpdateCasingOd(int index, double? value)
    {
        SimplifiedCasingRows[index].OD = value;
    }

    private void UpdateCasingId(int index, double? value)
    {
        SimplifiedCasingRows[index].ID = value;
    }

    private void UpdateCasingBoreholeOd(int index, double? value)
    {
        SimplifiedCasingRows[index].BoreholeOD = value;
    }

    private void UpdateCasingCement(int index, bool value)
    {
        SimplifiedCasingRows[index].HasCement = value;
    }

    private void AddOpenHoleRow()
    {
        OpenHoleRows.Add(CreateDefaultOpenHoleRow());
    }

    private void RemoveOpenHoleRow(int index)
    {
        if (OpenHoleRows.Count == 1)
        {
            return;
        }

        OpenHoleRows.RemoveAt(index);
    }

    private void MoveOpenHoleRow(int index, int delta)
    {
        var newIndex = index + delta;
        if (newIndex < 0 || newIndex >= OpenHoleRows.Count)
        {
            return;
        }

        var row = OpenHoleRows[index];
        OpenHoleRows.RemoveAt(index);
        OpenHoleRows.Insert(newIndex, row);
    }

    private void UpdateOpenHoleOd(int index, double? value)
    {
        OpenHoleRows[index].HoleSize = ConversionsFromOSDC.DoubleToGaussian(value);
    }

    private void UpdateOpenHoleLength(int index, double? value)
    {
        OpenHoleRows[index].Length = ConversionsFromOSDC.DoubleToGaussian(value);
    }

    private static double? GetGaussianValue(GaussianDrillingProperty? property) => ConversionsFromOSDC.GaussianToDouble(property);

    private IEnumerable<string> GetFluidLabels()
    {
        if (WellBoreArchitecture?.FluidsAboveGroundLevel == null || WellBoreArchitecture.FluidsAboveGroundLevel.Count == 0)
        {
            return new[] { "Air" };
        }

        return WellBoreArchitecture.FluidsAboveGroundLevel
            .Where(fluid => fluid != null)
            .Select(fluid => fluid.Fluid.ToString())
            .Distinct();
    }

    private List<SchematicTube> BuildSchematicTubes()
    {
        var segments = new List<SchematicTube>();
        var maxDiameter = GetMaxDiameter();
        if (maxDiameter <= 0.0)
        {
            maxDiameter = 1.0;
        }

        const double centerX = 160.0;
        var topsideY = TopsideY;
        var topsideHeight = TopsideHeight;

        var sections = EnsureSurfaceSectionsList();
        var surfaceTotalLength = sections.Sum(GetSurfaceSectionDisplayLength);
        var cursor = topsideY;
        foreach (var section in sections)
        {
            var segmentHeight = topsideHeight * (GetSurfaceSectionDisplayLength(section) / surfaceTotalLength);
            if (section.Type == SurfaceSectionType.BOP)
            {
                cursor += segmentHeight;
                continue;
            }
            var outerWidth = GetRiserDisplayWidth(maxDiameter);
            segments.Add(new SchematicTube(GetSurfaceLabel(section.Type), centerX - outerWidth / 2.0, cursor, outerWidth, 0.0, Math.Max(segmentHeight, 20.0), "#b6b6b6", "#5f5f5f", false));
            cursor += segmentHeight;
        }

        return segments;
    }

    private List<SchematicCasingString> BuildSchematicCasingStrings()
    {
        const double centerX = 160.0;
        const double downholeY = WellHeadTopY;
        const double downholeHeight = 430.0;
        const double maxOuterWidth = 66.0;
        const double nestingClearance = 8.0;
        const double reserveInnerWidth = 16.0;

        var groups = BuildSimplifiedCasingGroups();
        var strings = new List<SchematicCasingString>();
        if (groups.Count == 0)
        {
            return strings;
        }

        var maxDiameter = Math.Max(1.0, GetMaxDiameter());
        var allRows = groups.SelectMany(group => group.Rows).ToList();
        var minDepth = allRows.Min(row => row.SuspensionDepth ?? 0.0);
        var maxDepth = allRows.Max(row => Math.Max(row.SuspensionDepth ?? 0.0, row.FinalDepth ?? row.SuspensionDepth ?? 0.0));
        var depthRange = Math.Max(1.0, maxDepth - minDepth);
        var availableOuterWidth = maxOuterWidth;

        for (var groupIndex = 0; groupIndex < groups.Count; groupIndex++)
        {
            var group = groups[groupIndex];
            var requestedMaxOuterWidth = Math.Max(12.0, group.Rows.Max(row => GetWidthFromDiameter(row.OD, maxDiameter) * 0.5));
            var scale = requestedMaxOuterWidth > 0.0
                ? Math.Min(1.0, availableOuterWidth / requestedMaxOuterWidth)
                : 1.0;

            var segments = new List<SchematicCasingSegment>();
            var minInnerWidth = double.MaxValue;
            for (var rowIndex = 0; rowIndex < group.Rows.Count; rowIndex++)
            {
                var row = group.Rows[rowIndex];
                var startDepth = row.SuspensionDepth ?? 0.0;
                var endDepth = Math.Max(startDepth, row.FinalDepth ?? startDepth);
                var topY = downholeY + downholeHeight * ((startDepth - minDepth) / depthRange);
                var bottomY = downholeY + downholeHeight * ((endDepth - minDepth) / depthRange);

                var outerWidth = Math.Max(12.0, GetWidthFromDiameter(row.OD, maxDiameter) * 0.5 * scale);
                var requestedInnerWidth = row.ID.HasValue && row.ID.Value > 0.0
                    ? GetWidthFromDiameter(row.ID, maxDiameter) * 0.5 * scale
                    : outerWidth * 0.72;
                var innerWidth = Math.Min(outerWidth - 8.0, Math.Max(reserveInnerWidth, requestedInnerWidth));
                minInnerWidth = Math.Min(minInnerWidth, innerWidth);

                var nextRow = rowIndex + 1 < group.Rows.Count ? group.Rows[rowIndex + 1] : null;
                var shouldAnnotate = nextRow == null
                    || !AreClose(row.OD, nextRow.OD)
                    || !AreClose(row.ID, nextRow.ID);
                var depthAnnotation = shouldAnnotate ? $"Depth {FormatDepthForDisplay(endDepth)}" : string.Empty;
                var diameterAnnotation = shouldAnnotate
                    ? (row.ID.HasValue && row.ID.Value > 0.0
                        ? $"OD {FormatDiameterForDisplay(row.OD ?? 0.0)} / ID {FormatDiameterForDisplay(row.ID.Value)}"
                        : $"OD {FormatDiameterForDisplay(row.OD ?? 0.0)}")
                    : string.Empty;
                segments.Add(new SchematicCasingSegment(
                    centerX - outerWidth / 2.0,
                    topY,
                    bottomY,
                    outerWidth,
                    innerWidth,
                    depthAnnotation,
                    diameterAnnotation));
            }

            strings.Add(new SchematicCasingString(segments));
            availableOuterWidth = Math.Max(28.0, minInnerWidth - nestingClearance * 2.0);
        }

        return strings;
    }

    private List<SchematicBoreHoleSegment> BuildSchematicBoreHoleSegments()
    {
        var groups = BuildSimplifiedCasingGroups();
        var casingStrings = SchematicCasingStrings;
        var segments = new List<SchematicBoreHoleSegment>();
        for (var groupIndex = 0; groupIndex < Math.Min(groups.Count, casingStrings.Count); groupIndex++)
        {
            var group = groups[groupIndex];
            var casingString = casingStrings[groupIndex];
            if (group.Rows.Count == 0 || casingString.Segments.Count == 0)
            {
                continue;
            }

            var maxBoreHoleOd = group.Rows
                .Select(row => row.BoreholeOD)
                .Where(value => value.HasValue && value.Value > 0.0)
                .Select(value => value!.Value)
                .DefaultIfEmpty()
                .Max();

            if (maxBoreHoleOd <= 0.0)
            {
                continue;
            }

            var stringOuterWidth = casingString.Segments.Max(segment => segment.OuterWidth);
            var markerWidth = GetCasingMarkerWidth(stringOuterWidth);
            var minWidth = stringOuterWidth + 4.0;
            var maxWidth = stringOuterWidth + markerWidth * 2.0;
            var tocDepth = group.Rows
                .Where(row => row.HasCement)
                .Select(row => row.SuspensionDepth)
                .Where(value => value.HasValue)
                .Select(value => value!.Value)
                .Cast<double?>()
                .Min();

            var cursor = 0;
            while (cursor < group.Rows.Count && cursor < casingString.Segments.Count)
            {
                var currentRow = group.Rows[cursor];
                var currentBoreHoleOd = currentRow.BoreholeOD;
                var endIndex = cursor;
                while (endIndex + 1 < group.Rows.Count
                    && endIndex + 1 < casingString.Segments.Count
                    && AreClose(group.Rows[endIndex + 1].BoreholeOD, currentBoreHoleOd))
                {
                    endIndex++;
                }

                if (currentBoreHoleOd.HasValue && currentBoreHoleOd.Value > 0.0)
                {
                    var topSegment = casingString.Segments[cursor];
                    var bottomSegment = casingString.Segments[endIndex];
                    var ratio = Math.Clamp(currentBoreHoleOd.Value / maxBoreHoleOd, 0.0, 1.0);
                    var width = minWidth + (maxWidth - minWidth) * ratio;
                    var endDepth = group.Rows[endIndex].FinalDepth ?? group.Rows[endIndex].SuspensionDepth;
                    double? cementTopY = null;
                    string? tocDepthAnnotation = null;
                    if (tocDepth.HasValue)
                    {
                        var segmentTopDepth = group.Rows[cursor].SuspensionDepth ?? 0.0;
                        var segmentBottomDepth = group.Rows[endIndex].FinalDepth ?? segmentTopDepth;
                        if (tocDepth.Value <= segmentBottomDepth + CasingGroupingTolerance)
                        {
                            if (tocDepth.Value <= segmentTopDepth + CasingGroupingTolerance)
                            {
                                cementTopY = topSegment.TopY;
                            }
                            else
                            {
                                var localRange = Math.Max(CasingGroupingTolerance, segmentBottomDepth - segmentTopDepth);
                                var ratioToTop = (tocDepth.Value - segmentTopDepth) / localRange;
                                cementTopY = topSegment.TopY + (bottomSegment.BottomY - topSegment.TopY) * ratioToTop;
                            }

                            tocDepthAnnotation = $"TOC Depth {FormatDepthForDisplay(tocDepth.Value)}";
                        }
                    }

                    segments.Add(new SchematicBoreHoleSegment(
                        topSegment.X + topSegment.OuterWidth / 2.0,
                        topSegment.TopY,
                        bottomSegment.BottomY,
                        width,
                        cementTopY,
                        tocDepthAnnotation,
                        $"Depth {FormatDepthForDisplay(endDepth)}",
                        $"OD {FormatDiameterForDisplay(currentBoreHoleOd.Value)}"));
                }

                cursor = endIndex + 1;
            }
        }

        return segments;
    }

    private List<SimplifiedCasingGroup> BuildSimplifiedCasingGroups()
    {
        return BuildSimplifiedCasingGroups(EnsureSimplifiedCasingRows());
    }

    private static List<SimplifiedCasingGroup> BuildSimplifiedCasingGroups(IEnumerable<SimplifiedCasingRow> sourceRows)
    {
        var groups = new List<SimplifiedCasingGroup>();
        var currentRows = new List<SimplifiedCasingRow>();
        double? currentEnd = null;

        foreach (var row in sourceRows)
        {
            var rowStart = row.SuspensionDepth ?? 0.0;
            var rowEnd = Math.Max(rowStart, row.FinalDepth ?? rowStart);
            if (currentRows.Count == 0 || currentEnd == null || Math.Abs(rowStart - currentEnd.Value) <= CasingGroupingTolerance)
            {
                currentRows.Add(row);
            }
            else
            {
                groups.Add(new SimplifiedCasingGroup(currentRows.ToList()));
                currentRows = new List<SimplifiedCasingRow> { row };
            }

            currentEnd = rowEnd;
        }

        if (currentRows.Count > 0)
        {
            groups.Add(new SimplifiedCasingGroup(currentRows));
        }

        return groups;
    }

    private List<SchematicOpenHoleSegment> BuildSchematicOpenHoleSegments()
    {
        var rows = EnsureOpenHoleRows();
        var casingStrings = SchematicCasingStrings;
        var innermostCasingString = casingStrings.LastOrDefault();
        var innermostSegment = innermostCasingString?.Segments.LastOrDefault();
        if (rows.Count == 0 || innermostSegment == null)
        {
            return new List<SchematicOpenHoleSegment>();
        }

        var groups = BuildSimplifiedCasingGroups();
        var casingRows = groups.SelectMany(group => group.Rows).ToList();
        var minDepth = casingRows.Count > 0 ? casingRows.Min(row => row.SuspensionDepth ?? 0.0) : 0.0;
        var maxDepth = casingRows.Count > 0
            ? casingRows.Max(row => Math.Max(row.SuspensionDepth ?? 0.0, row.FinalDepth ?? row.SuspensionDepth ?? 0.0))
            : 1.0;
        var depthRange = Math.Max(1.0, maxDepth - minDepth);
        const double downholeHeight = 430.0;
        var pixelsPerDepth = downholeHeight / depthRange;

        var referenceDiameter = Math.Max(0.01, GetInnermostCasingInnerDiameter() ?? 0.01);
        var referenceWidth = Math.Max(10.0, innermostSegment.InnerWidth);
        var cursor = innermostSegment.BottomY;
        var centerX = innermostSegment.X + innermostSegment.OuterWidth / 2.0;

        var segments = new List<SchematicOpenHoleSegment>();
        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            var length = Math.Max(0.0, GetGaussianValue(row.Length) ?? 0.0);
            var segmentHeight = Math.Max(12.0, length * pixelsPerDepth);
            var holeDiameter = Math.Max(referenceDiameter, GetGaussianValue(row.HoleSize) ?? referenceDiameter);
            var width = Math.Max(referenceWidth, referenceWidth * (holeDiameter / referenceDiameter));
            var endDepth = GetOpenHoleSectionEndDepth(rows, i, maxDepth);
            var depthAnnotation = $"Depth {FormatDepthForDisplay(endDepth)}";
            var diameterAnnotation = $"OD {FormatDiameterForDisplay(GetGaussianValue(row.HoleSize) ?? holeDiameter)}";
            segments.Add(new SchematicOpenHoleSegment(centerX, cursor, cursor + segmentHeight, width, depthAnnotation, diameterAnnotation));
            cursor += segmentHeight;
        }

        return segments;
    }

    private List<SchematicPoint> BuildJaggedOpenHolePointList(double edgeX, double topY, double bottomY, bool isLeft)
    {
        const double amplitude = 3.0;
        const double step = 10.0;
        var points = new List<SchematicPoint> { new(edgeX, topY) };
        var y = topY;
        var direction = isLeft ? -1.0 : 1.0;
        var toggle = false;
        while (y < bottomY)
        {
            y = Math.Min(bottomY, y + step);
            var x = edgeX + (toggle ? amplitude * direction : 0.0);
            points.Add(new SchematicPoint(x, y));
            toggle = !toggle;
        }

        return points;
    }

    private double GetOpenHoleSectionEndDepth(List<BoreHoleSize> rows, int index, double casingBottomDepth)
    {
        var depth = casingBottomDepth;
        for (var i = 0; i <= index; i++)
        {
            depth += Math.Max(0.0, GetGaussianValue(rows[i].Length) ?? 0.0);
        }

        return depth;
    }

    private string FormatDiameterForDisplay(double value) => FormatDiameterQuantityWithUnit(value);

    private string FormatDrillingQuantity(double value, OSDC.UnitConversion.Conversion.DrillingEngineering.DrillingPhysicalQuantity.QuantityEnum quantity)
    {
        return GetCurrentDrillingUnitSystem().FromSIString(quantity, value);
    }

    private string FormatDepthQuantityWithUnit(double value) =>
        FormatQuantityWithUnit(value, OSDC.UnitConversion.Conversion.DrillingEngineering.DrillingPhysicalQuantity.QuantityEnum.DepthDrilling);

    private string FormatDiameterQuantityWithUnit(double value) =>
        FormatQuantityWithUnit(value, OSDC.UnitConversion.Conversion.DrillingEngineering.DrillingPhysicalQuantity.QuantityEnum.DiameterPipeDrilling);

    private string FormatQuantityWithUnit(double value, OSDC.UnitConversion.Conversion.DrillingEngineering.DrillingPhysicalQuantity.QuantityEnum quantity)
    {
        var unitSystem = GetCurrentDrillingUnitSystem();
        return $"{unitSystem.FromSIString(quantity, value)} {unitSystem.GetUnitLabel(quantity)}";
    }

    private OSDC.UnitConversion.Conversion.UnitSystem.DrillingEngineering.DrillingUnitSystem GetCurrentDrillingUnitSystem()
    {
        var unitSystem = DataUtils.UnitAndReferenceParameters.UnitSystemName ?? "Metric";
        if (unitSystem.Contains("US", StringComparison.OrdinalIgnoreCase))
        {
            return OSDC.UnitConversion.Conversion.UnitSystem.DrillingEngineering.DrillingUnitSystem.USUnitSystem;
        }

        if (unitSystem.Contains("English", StringComparison.OrdinalIgnoreCase)
            || unitSystem.Contains("Imperial", StringComparison.OrdinalIgnoreCase))
        {
            return OSDC.UnitConversion.Conversion.UnitSystem.DrillingEngineering.DrillingUnitSystem.ImperialUnitSystem;
        }

        if (unitSystem.Contains("SI", StringComparison.OrdinalIgnoreCase))
        {
            return OSDC.UnitConversion.Conversion.UnitSystem.DrillingEngineering.DrillingUnitSystem.SIUnitSystem;
        }

        return OSDC.UnitConversion.Conversion.UnitSystem.DrillingEngineering.DrillingUnitSystem.MetricUnitSystem;
    }

    private double GetOuterMostCasingHangerWidth()
    {
        var outerMostString = BuildSchematicCasingStrings().FirstOrDefault();
        var firstSegment = outerMostString?.Segments.FirstOrDefault();
        if (firstSegment == null)
        {
            return 20.0;
        }

        return GetCasingMarkerWidth(firstSegment.OuterWidth);
    }

    private static double GetCasingMarkerWidth(double segmentOuterWidth)
    {
        return Math.Max(10.0, Math.Min(18.67, segmentOuterWidth * 0.1467));
    }

    private static double GetCasingMarkerHeight(double wallThickness)
    {
        return Math.Max(6.67, wallThickness * 1.87);
    }

    private static double GetCasingShoeHeight(double wallThickness)
    {
        return Math.Max(12.0, wallThickness * 3.33);
    }

    private List<SchematicEquipmentBlock> BuildSchematicEquipment()
    {
        var blocks = new List<SchematicEquipmentBlock>();
        const double centerX = 160.0;
        var sections = EnsureSurfaceSectionsList();
        var surfaceTotalLength = sections.Sum(GetSurfaceSectionDisplayLength);
        var cursor = TopsideY;
        var maxDiameter = Math.Max(1.0, GetMaxDiameter());

        foreach (var section in sections)
        {
            var segmentHeight = TopsideHeight * (GetSurfaceSectionDisplayLength(section) / surfaceTotalLength);
            if (section.Type == SurfaceSectionType.BOP)
            {
                var width = GetBopDisplayWidth(section, maxDiameter);
                blocks.Add(new SchematicEquipmentBlock(GetSurfaceLabel(section.Type), centerX - width / 2.0, cursor, width, Math.Max(segmentHeight, 36.0), "#ef2f2f", "#981b1b", true));
            }

            cursor += segmentHeight;
        }

        return blocks;
    }

    private double GetSurfaceSectionDisplayLength(SurfaceSection section)
    {
        var length = GetGaussianValue(section.SectionLength);
        if (length.HasValue && length.Value > 0.0)
        {
            return length.Value;
        }

        if (section.Type == SurfaceSectionType.BOP)
        {
            return CurrentSurfaceConfiguration == SurfaceConfiguration.OffshoreFloater ? 12.0 : 6.0;
        }

        return 10.0;
    }

    private double GetRiserDisplayWidth(double maxDiameter)
    {
        var bopSection = EnsureSurfaceSectionsList().FirstOrDefault(section => section.Type == SurfaceSectionType.BOP);
        var bopWidth = bopSection != null ? GetBopDisplayWidth(bopSection, maxDiameter) : 18.0;
        return Math.Max(8.0, bopWidth * 0.44);
    }

    private double GetBopDisplayWidth(SurfaceSection bopSection, double maxDiameter)
    {
        return Math.Max(18.0, (Math.Max(52.0, GetWidthFromDiameter(GetGaussianValue(bopSection.BodyOD), maxDiameter) + 22.0)) * 0.2);
    }

    private double GetMaxDiameter()
    {
        var diameters = new List<double?>
        {
            ConversionsFromOSDC.ScalarToDouble(WellBoreArchitecture?.WellHead?.MaxOD)
        };

        diameters.AddRange(EnsureSurfaceSectionsList().Select(section => GetGaussianValue(section.BodyOD)));
        diameters.AddRange(SimplifiedCasingRows.Select(row => row.OD));
        diameters.AddRange(EnsureOpenHoleRows().Select(row => GetGaussianValue(row.HoleSize)));

        return diameters.Where(value => value != null && value > 0.0).DefaultIfEmpty(1.0).Max() ?? 1.0;
    }

    private double? GetInnermostCasingInnerDiameter()
    {
        return SimplifiedCasingRows
            .Select(row => row.ID)
            .Where(value => value.HasValue && value.Value > 0.0)
            .LastOrDefault();
    }

    private static double GetWidthFromDiameter(double? diameter, double maxDiameter)
    {
        var normalized = diameter.HasValue && diameter.Value > 0.0 ? diameter.Value / maxDiameter : 0.35;
        return 48.0 + (160.0 * normalized);
    }

    private static string GetSurfaceLabel(SurfaceSectionType type) => type switch
    {
        SurfaceSectionType.BOP => "BOP",
        SurfaceSectionType.HighPressureRiser => "HP riser",
        SurfaceSectionType.LowPressureRiser => "LP riser",
        SurfaceSectionType.MarineRiser => "Marine riser",
        _ => "Surface"
    };

    private async Task SaveWellBoreArchitecture()
    {
        if (WellBoreArchitecture == null)
        {
            return;
        }

        await CommitActiveEditorAsync();

        var isEditMode = IsEditMode;
        if (EditorMode == ArchitectureEditorMode.Simplified)
        {
            ApplySimplifiedRowsToDetailedSections();
        }
        
        try
        {
            if (string.IsNullOrWhiteSpace(WellBoreArchitecture.Name))
            {
                WellBoreArchitecture.Name = "Wellbore Architecture";
            }

            WellBoreArchitecture.WellBoreID = _selectedWellBore?.MetaInfo?.ID is Guid wellBoreId && wellBoreId != Guid.Empty
                ? wellBoreId
                : null;

            if (isEditMode)
            {
                WellBoreArchitecture.LastModificationDate = DateTimeOffset.UtcNow;
                await Api.ClientWellBoreArchitecture.PutWellBoreArchitectureByIdAsync(WellBoreArchitecture.MetaInfo.ID, WellBoreArchitecture);
                logger.LogInformation("Wellbore Architecture updated successfully");
                Snackbar.Add("Wellbore Architecture updated successfully", Severity.Success);
            }
            else
            {
                var creationDate = DateTimeOffset.UtcNow;
                WellBoreArchitecture.MetaInfo = new MetaInfo
                {
                    ID = Guid.NewGuid(),
                    HttpHostName = Api.HostNameWellBoreArchitecture,
                    HttpHostBasePath = Api.HostBasePathWellBoreArchitecture,
                    HttpEndPoint = "WellBoreArchitecture/"
                };
                WellBoreArchitecture.CreationDate = creationDate;
                WellBoreArchitecture.LastModificationDate = creationDate;
                await Api.ClientWellBoreArchitecture.PostWellBoreArchitectureAsync(WellBoreArchitecture);
                logger.LogInformation("WellBoreArchitecture posted successfully");
                Snackbar.Add("WellBoreArchitecture posted successfully", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            if (isEditMode)
            {
                logger.LogError(ex, "Impossible to update Wellbore Architecture");
                Snackbar.Add("Impossible to update Wellbore Architecture", Severity.Warning);
            }
            else
            {
                logger.LogError(ex, "Impossible to add a new WellBoreArchitecture");
                Snackbar.Add("Impossible to add a new WellBoreArchitecture", Severity.Warning);
            }
        }

        OnUpdate?.Invoke();
    }

    private async Task CommitActiveEditorAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("wellBoreArchitecture.blurActiveElement");
            await Task.Yield();
        }
        catch (JSException ex)
        {
            logger.LogWarning(ex, "Unable to blur the active editor before saving");
        }
    }

    private void CloseWellBoreArchitecture()
    {
        OnUpdate?.Invoke();
    }

