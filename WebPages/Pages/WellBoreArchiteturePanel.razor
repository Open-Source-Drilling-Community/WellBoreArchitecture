    }

    private List<WellBoreArchitectureFluid> EnsureFluidsList()
    {
        if (WellBoreArchitecture == null)
        {
            return new List<WellBoreArchitectureFluid>();
        }

        if (WellBoreArchitecture.FluidsAboveGroundLevel is not List<WellBoreArchitectureFluid> list)
        {
            list = WellBoreArchitecture.FluidsAboveGroundLevel?.ToList() ?? new List<WellBoreArchitectureFluid>();
            WellBoreArchitecture.FluidsAboveGroundLevel = list;
        }

        return list;
    }

    private bool ShouldShowWaterAboveMudLine =>
        CurrentSurfaceConfiguration == SurfaceConfiguration.OffshoreFloater ||
        (CurrentSurfaceConfiguration == SurfaceConfiguration.OffshoreFixed && _includeWaterAboveMudLine);

    private void EnsureFluidsForCurrentConfiguration()
    {
        if (WellBoreArchitecture == null)
        {
            return;
        }

        var current = EnsureFluidsList();
        var airDepth = current.FirstOrDefault(fluid => fluid.Fluid == FluidType.Air)?.Depth;
        var waterDepth = current.FirstOrDefault(fluid => fluid.Fluid == FluidType.Water)?.Depth;

        if (CurrentSurfaceConfiguration == SurfaceConfiguration.Onshore)
        {
            _includeWaterAboveMudLine = false;
            WellBoreArchitecture.FluidsAboveGroundLevel = new List<WellBoreArchitectureFluid>
            {
                new()
                {
                    Fluid = FluidType.Air,
                    Depth = airDepth ?? ConversionsFromOSDC.DoubleToGaussian(DataUtils.UnitAndReferenceParameters.GroundMudLineDepthReferenceSource.GroundMudLineDepthReference)
                }
            };
            return;
        }

        if (CurrentSurfaceConfiguration == SurfaceConfiguration.OffshoreFloater)
        {
            _includeWaterAboveMudLine = true;
        }

        var fluids = new List<WellBoreArchitectureFluid>();
        if (ShouldShowWaterAboveMudLine)
        {
            fluids.Add(new WellBoreArchitectureFluid
            {
                Fluid = FluidType.Water,
                Depth = waterDepth ?? ConversionsFromOSDC.DoubleToGaussian(DataUtils.UnitAndReferenceParameters.GroundMudLineDepthReferenceSource.GroundMudLineDepthReference)
            });
            fluids.Add(new WellBoreArchitectureFluid
            {
                Fluid = FluidType.Air,
                Depth = airDepth ?? ConversionsFromOSDC.DoubleToGaussian(DataUtils.UnitAndReferenceParameters.SeaWaterLevelDepthReferenceSource.SeaWaterLevelDepthReference)
            });
        }
        else
        {
            fluids.Add(new WellBoreArchitectureFluid
            {
                Fluid = FluidType.Air,
                Depth = airDepth ?? ConversionsFromOSDC.DoubleToGaussian(DataUtils.UnitAndReferenceParameters.GroundMudLineDepthReferenceSource.GroundMudLineDepthReference)
            });
        }

        WellBoreArchitecture.FluidsAboveGroundLevel = fluids;
    }

    private double? GetGroundOrMudLineDepth()
    {
        var fluids = EnsureFluidsList();
        if (ShouldShowWaterAboveMudLine)
        {
            return ConversionsFromOSDC.GaussianToDouble(fluids.FirstOrDefault(fluid => fluid.Fluid == FluidType.Water)?.Depth);
        }

        return ConversionsFromOSDC.GaussianToDouble(fluids.FirstOrDefault(fluid => fluid.Fluid == FluidType.Air)?.Depth);
    }

    private Task OnGroundOrMudLineDepthChanged(double? value)
    {
        var gaussian = ConversionsFromOSDC.DoubleToGaussian(value);
        var fluids = EnsureFluidsList();
        if (ShouldShowWaterAboveMudLine)
        {
            var water = fluids.FirstOrDefault(fluid => fluid.Fluid == FluidType.Water);
            if (water != null)
            {
                water.Depth = gaussian;
            }
        }
        else
        {
            var air = fluids.FirstOrDefault(fluid => fluid.Fluid == FluidType.Air);
            if (air != null)
            {
                air.Depth = gaussian;
            }
        }

        return Task.CompletedTask;
    }

    private double? GetTopWaterDepth() =>
        ConversionsFromOSDC.GaussianToDouble(EnsureFluidsList().FirstOrDefault(fluid => fluid.Fluid == FluidType.Air)?.Depth);

    private Task OnTopWaterDepthChanged(double? value)
    {
        var air = EnsureFluidsList().FirstOrDefault(fluid => fluid.Fluid == FluidType.Air);
        if (air != null)
        {
            air.Depth = ConversionsFromOSDC.DoubleToGaussian(value);
        }

        return Task.CompletedTask;
    }

    private Task OnWaterAboveMudLineChanged(bool value)
    {
        _includeWaterAboveMudLine = value;
        EnsureFluidsForCurrentConfiguration();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string FormatDepthForDisplay(double? depth)
    {
        if (depth == null)
        {
            return "-";
        }

        if (Parent != null)
        {
            var convertedDepth = Parent.FromWGS84DepthSI(depth, "DepthDrilling", true);
            if (!string.IsNullOrWhiteSpace(convertedDepth))
            {
                return convertedDepth;
            }
        }

        var depthReference = DataUtils.UnitAndReferenceParameters.DepthReferenceName ?? "reference";
        var formatted = FormatDepthQuantityWithUnit(depth.Value);
        if (depthReference.Contains("rotary table", StringComparison.OrdinalIgnoreCase))
        {
            return formatted;
        }

        return $"{formatted} ({depthReference})";
    }

    private static string Svg(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private double GetDrillFloorY()
    {
        var rigHeight = GetRigHeightPixels();
        var minDrillFloorY = TopsideZoneTopY + DerrickTopClearance + rigHeight;
        var maxDrillFloorY = WellHeadTopY - 24.0 - SurfaceBottomGap;
        return Math.Clamp(minDrillFloorY, 72.0, maxDrillFloorY);
    }

    private double GetRigHeightPixels()
    {
        const double rigHeightMeters = 50.0;
        var surfaceLength = GetSurfaceArchitectureLength();
        var totalLength = rigHeightMeters + Math.Max(0.0, surfaceLength);
        var availableHeight = TopsideZoneHeight - DerrickTopClearance - SurfaceBottomGap - 24.0;
        if (totalLength <= 0.0 || availableHeight <= 0.0)
        {
            return 96.0;
        }

        var scaledHeight = availableHeight * (rigHeightMeters / totalLength);
        return Math.Clamp(scaledHeight, 72.0, 140.0);
    }

    private double GetSurfaceArchitectureLength()
    {
        var totalLength = EnsureSurfaceSectionsList()
            .Select(section => GetGaussianValue(section.SectionLength))
            .Where(length => length.HasValue && length.Value > 0.0)
            .Sum(length => length!.Value);

        return totalLength > 0.0 ? totalLength : Math.Max(1.0, EnsureSurfaceSectionsList().Count * 10.0);
    }

    private async Task ResolveRigAsync()
    {
        _resolvedRig = null;

        var rigId = _selectedWellBore?.RigID;
        if ((!rigId.HasValue || rigId == Guid.Empty) && _resolvedCluster?.MetaInfo?.ID is Guid clusterId && clusterId != Guid.Empty)
        {
            rigId = Rigs?
                .Values
                .FirstOrDefault(rig => rig?.ClusterID == clusterId)
                ?.MetaInfo?.ID;
        }

        if (!rigId.HasValue || rigId == Guid.Empty)
        {
            return;
        }

        try
        {
            _resolvedRig = await Api.ClientRig.GetRigByIdAsync(rigId.Value);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Impossible to resolve Rig details for rig id {RigId}", rigId.Value);
        }
    }

    private double? GetDrillFloorDepth() => _resolvedRig?.DrillFloorElevation;

    private List<SurfaceSection> EnsureSurfaceSectionsList()
    {
        if (WellBoreArchitecture == null)
        {
            return new List<SurfaceSection>();
        }

        if (WellBoreArchitecture.SurfaceSections is not List<SurfaceSection> list)
        {
            list = WellBoreArchitecture.SurfaceSections?.ToList() ?? new List<SurfaceSection>();
            WellBoreArchitecture.SurfaceSections = list;
        }

        if (list.Count == 0)
        {
            list.Add(CreateSurfaceSection(SurfaceSectionType.Unknown));
        }

        return list;
    }

    private void EnsureSurfaceSectionsForCurrentConfiguration()
    {
        if (WellBoreArchitecture == null)
        {
            return;
        }

        var current = EnsureSurfaceSectionsList();
        var existingByType = current
            .GroupBy(section => section.Type)
            .ToDictionary(group => group.Key, group => group.First());

        var desired = new List<SurfaceSection>();
        foreach (var descriptor in SurfaceSectionDescriptors)
        {
            if (existingByType.TryGetValue(descriptor.Type, out var existing))
            {
                desired.Add(existing);
            }
            else
            {
                desired.Add(CreateSurfaceSection(descriptor.Type));
            }
        }

        WellBoreArchitecture.SurfaceSections = desired;
        EnsureOptionalSideConnectors();
    }

    private SurfaceSection GetSurfaceSectionAt(int index)
    {
        var list = EnsureSurfaceSectionsList();
        while (list.Count <= index)
        {
            list.Add(CreateSurfaceSection(SurfaceSectionDescriptors[Math.Min(index, SurfaceSectionDescriptors.Count - 1)].Type));
        }

        return list[index];
    }

    private static SurfaceSection CreateSurfaceSection(SurfaceSectionType type)
    {
        return new SurfaceSection
        {
            Type = type,
            BodyOD = ConversionsFromOSDC.DoubleToGaussian(null),
            BodyID = ConversionsFromOSDC.DoubleToGaussian(null),
            SectionLength = ConversionsFromOSDC.DoubleToGaussian(null),
            SideConnectors = new List<SideConnector>()
        };
    }

    private List<SurfaceSectionDescriptor> GetSurfaceSectionDescriptors(SurfaceConfiguration configuration)
    {
        var descriptors = new List<SurfaceSectionDescriptor>();

        switch (configuration)
        {
            case SurfaceConfiguration.OffshoreFixed:
                descriptors.Add(new SurfaceSectionDescriptor("Low pressure riser", SurfaceSectionType.LowPressureRiser));
                if (_includeBop)
                {
                    descriptors.Add(new SurfaceSectionDescriptor("BOP", SurfaceSectionType.BOP));
                }

                descriptors.Add(new SurfaceSectionDescriptor("High pressure riser", SurfaceSectionType.HighPressureRiser));
                break;

            case SurfaceConfiguration.OffshoreFloater:
                if (_includeMarineRiser)
                {
                    descriptors.Add(new SurfaceSectionDescriptor("Marine riser", SurfaceSectionType.MarineRiser));
                }
                if (_includeBop)
                {
                    descriptors.Add(new SurfaceSectionDescriptor("Marine BOP", SurfaceSectionType.BOP));
                }

                break;

            default:
                descriptors.Add(new SurfaceSectionDescriptor("Low pressure riser", SurfaceSectionType.LowPressureRiser));
                if (_includeBop)
                {
                    descriptors.Add(new SurfaceSectionDescriptor("BOP", SurfaceSectionType.BOP));
                }

                break;
        }

        return descriptors;
    }

    private SurfaceConfiguration GetSurfaceConfiguration()
    {
        if (_resolvedCluster == null)
        {
            return SurfaceConfiguration.Onshore;
        }

        if (!IsOffshoreCluster(_resolvedCluster))
        {
            return SurfaceConfiguration.Onshore;
        }

        return _resolvedCluster.IsFixedPlatform ? SurfaceConfiguration.OffshoreFixed : SurfaceConfiguration.OffshoreFloater;
    }

    private Task OnBopToggleChanged(bool value)
    {
        _includeBop = value;
        if (!_includeBop && !_includeMarineRiser)
        {
            _includeLiftPump = false;
        }

        EnsureSurfaceSectionsForCurrentConfiguration();
        if (!_includeBop)
        {
            RemoveOptionalSideConnectors();
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnMarineRiserToggleChanged(bool value)
    {
        var liftPumpDepth = GetLiftPumpDepth();
        _includeMarineRiser = value;
        if (!_includeMarineRiser && !_includeBop)
        {
            _includeLiftPump = false;
        }

        EnsureSurfaceSectionsForCurrentConfiguration();
        if (_includeLiftPump)
        {
            UpdateLiftPumpDepth(liftPumpDepth);
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void EnsureOptionalSideConnectors()
    {
        if (_includeBop)
        {
            EnsureNamedSideConnector(GetBopSurfaceSection(), "ChokeLine", SideElementType.Choke);
            EnsureNamedSideConnector(GetBopSurfaceSection(), "KillLine", SideElementType.Pipe);
        }
        else
        {
            RemoveNamedSideConnector(GetBopSurfaceSection(), "ChokeLine");
            RemoveNamedSideConnector(GetBopSurfaceSection(), "KillLine");
        }

        if (ShouldShowBoosterLineDepth())
        {
            EnsureNamedSideConnector(GetMarineRiserSection(), "BoosterLine", SideElementType.Pipe);
        }
        else
        {
            RemoveNamedSideConnector(GetMarineRiserSection(), "BoosterLine");
        }

        SyncLiftPumpConnector();
    }

    private void RemoveOptionalSideConnectors()
    {
        RemoveNamedSideConnector(GetBopSurfaceSection(), "ChokeLine");
        RemoveNamedSideConnector(GetBopSurfaceSection(), "KillLine");
        RemoveNamedSideConnector(GetMarineRiserSection(), "BoosterLine");
        RemoveNamedSideConnector(GetMarineRiserSection(), "LiftPump");
        RemoveNamedSideConnector(GetBopSurfaceSection(), "LiftPump");
    }

    private SurfaceSection? GetBopSurfaceSection() =>
        EnsureSurfaceSectionsList().FirstOrDefault(section => section.Type == SurfaceSectionType.BOP);

    private SurfaceSection? GetMarineRiserSection() =>
        EnsureSurfaceSectionsList().FirstOrDefault(section => section.Type == SurfaceSectionType.MarineRiser);

    private static SideConnector EnsureNamedSideConnector(SurfaceSection? section, string name, SideElementType sideElementType)
    {
        if (section == null)
        {
            return new SideConnector();
        }

        if (section.SideConnectors is not List<SideConnector> connectors)
        {
            connectors = section.SideConnectors?.ToList() ?? new List<SideConnector>();
            section.SideConnectors = connectors;
        }

        var connector = connectors.FirstOrDefault(connector => connector?.FirstSideElement?.Name == name);
        if (connector != null)
        {
            return connector;
        }

        connector = new SideConnector
        {
            Position = ConversionsFromOSDC.DoubleToGaussian(null),
            VerticalDepth = ConversionsFromOSDC.DoubleToGaussian(null),
            FirstSideElement = new SideElement
            {
                Name = name,
                Type = sideElementType,
                OD = ConversionsFromOSDC.DoubleToGaussian(null),
                ID = ConversionsFromOSDC.DoubleToGaussian(null),
                Length = ConversionsFromOSDC.DoubleToGaussian(null),
                TopVerticalDepth = ConversionsFromOSDC.DoubleToGaussian(null)
            },
            ElementConnectivities = new List<ElementConnectivity>()
        };
        connectors.Add(connector);
        return connector;
    }

    private static void RemoveNamedSideConnector(SurfaceSection? section, string name)
    {
        if (section?.SideConnectors is not IList<SideConnector> connectors)
        {
            return;
        }

        var connector = connectors.FirstOrDefault(item => item?.FirstSideElement?.Name == name);
        if (connector != null)
        {
            connectors.Remove(connector);
        }
    }

    private static bool HasNamedSideConnector(SurfaceSection? section, string name) =>
        section?.SideConnectors?.Any(item => item?.FirstSideElement?.Name == name) ?? false;

    private double? GetBopConnectorDepth(string name)
    {
        var connector = GetBopSurfaceSection()?.SideConnectors?.FirstOrDefault(item => item?.FirstSideElement?.Name == name);
        return ConversionsFromOSDC.GaussianToDouble(connector?.VerticalDepth);
    }

    private double? GetChokeLineDepth() => GetBopConnectorDepth("ChokeLine");

    private double? GetKillLineDepth() => GetBopConnectorDepth("KillLine");

    private void UpdateBopConnectorDepth(string name, double? value)
    {
        var type = name == "ChokeLine" ? SideElementType.Choke : SideElementType.Pipe;
        var connector = EnsureNamedSideConnector(GetBopSurfaceSection(), name, type);
        connector.Position = ConversionsFromOSDC.DoubleToGaussian(value);
        connector.VerticalDepth = ConversionsFromOSDC.DoubleToGaussian(value);
        if (connector.FirstSideElement != null)
        {
            connector.FirstSideElement.TopVerticalDepth = ConversionsFromOSDC.DoubleToGaussian(value);
        }
    }

