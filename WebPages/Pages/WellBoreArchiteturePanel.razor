    private bool HasInitializedSelectionState()
    {
        if (WellBoreArchitecture == null)
        {
            return false;
        }

        var wellBoreId = WellBoreArchitecture.WellBoreID;
        if (wellBoreId == null || wellBoreId == Guid.Empty)
        {
            return true;
        }

        return _selectedWellBore?.MetaInfo?.ID == wellBoreId.Value;
    }

    private void EnsureDefaults()
    {
        if (WellBoreArchitecture == null)
        {
            return;
        }

        WellBoreArchitecture.WellHead ??= Api.DefaultWellHead();
        WellBoreArchitecture.FluidsAboveGroundLevel ??= Api.DefaultFluidsAboveGroundLevel();
        WellBoreArchitecture.SurfaceSections ??= Api.DefaultSurfaceSections();
        WellBoreArchitecture.CasingSections ??= Api.DefaultCasingSections();
        EnsureCasingSectionsList();
        EnsureSimplifiedCasingRows();
        EnsureOpenHoleRows();
        EnsureFluidsForCurrentConfiguration();
    }

    private static void ApplyClusterReferenceValues(Cluster cluster)
    {
        if (cluster.ReferenceDepth?.GaussianValue?.Mean != null)
        {
            DataUtils.UnitAndReferenceParameters.WellHeadDepthReferenceSource.WellHeadDepthReference = cluster.ReferenceDepth.GaussianValue.Mean;
        }

        if (cluster.GroundMudLineDepth?.GaussianValue?.Mean != null)
        {
            DataUtils.UnitAndReferenceParameters.GroundMudLineDepthReferenceSource.GroundMudLineDepthReference = cluster.GroundMudLineDepth.GaussianValue.Mean;
        }

        if (cluster.TopWaterDepth?.GaussianValue?.Mean != null)
        {
            DataUtils.UnitAndReferenceParameters.SeaWaterLevelDepthReferenceSource.SeaWaterLevelDepthReference = cluster.TopWaterDepth.GaussianValue.Mean;
        }
    }

    private async Task SyncDepthReferenceSourcesAsync(bool forceRefresh = false)
    {
        var snapshot = (
            GroundMudLine: GetGroundOrMudLineDepth(),
            SeaWaterLevel: GetSeaWaterLevelReferenceDepth(),
            WellHead: GetWellHeadReferenceDepth(),
            RotaryTable: GetRotaryTableReferenceDepth());

        DataUtils.UnitAndReferenceParameters.GroundMudLineDepthReferenceSource.GroundMudLineDepthReference = -snapshot.GroundMudLine;
        DataUtils.UnitAndReferenceParameters.SeaWaterLevelDepthReferenceSource.SeaWaterLevelDepthReference = -snapshot.SeaWaterLevel;
        DataUtils.UnitAndReferenceParameters.WellHeadDepthReferenceSource.WellHeadDepthReference = -snapshot.WellHead;
        DataUtils.UnitAndReferenceParameters.RotaryTableDepthReferenceSource.RotaryTableDepthReference = -snapshot.RotaryTable;

        var hasChanged = forceRefresh
            || !_hasDepthReferenceSnapshot
            || !Nullable.Equals(_lastDepthReferenceSnapshot.GroundMudLine, snapshot.GroundMudLine)
            || !Nullable.Equals(_lastDepthReferenceSnapshot.SeaWaterLevel, snapshot.SeaWaterLevel)
            || !Nullable.Equals(_lastDepthReferenceSnapshot.WellHead, snapshot.WellHead)
            || !Nullable.Equals(_lastDepthReferenceSnapshot.RotaryTable, snapshot.RotaryTable);

        _lastDepthReferenceSnapshot = snapshot;
        _hasDepthReferenceSnapshot = true;

        if (hasChanged && Parent != null)
        {
            await Parent.RefreshDepthReferenceAsync();
        }
    }

    private double? GetSeaWaterLevelReferenceDepth() => ShouldShowWaterAboveMudLine ? GetTopWaterDepth() : null;

    private double? GetWellHeadReferenceDepth()
    {
        var architectureWellHeadDepth = ConversionsFromOSDC.GaussianToDouble(WellBoreArchitecture?.WellHead?.Depth);
        if (architectureWellHeadDepth.HasValue)
        {
            return architectureWellHeadDepth;
        }

        return _resolvedCluster?.ReferenceDepth?.GaussianValue?.Mean;
    }

    private double? GetRotaryTableReferenceDepth()
    {
        if (_resolvedRig?.DrillFloorElevation != null)
        {
            return _resolvedRig.DrillFloorElevation;
        }

        return null;
    }

    private async Task OnSelectedFieldChanged(Field? field)
    {
        _selectedField = field;
        _selectedCluster = null;
        _resolvedCluster = null;
        _resolvedRig = null;
        _selectedWell = null;
        _selectedWellBore = null;
        EnsureSurfaceSectionsForCurrentConfiguration();
        EnsureFluidsForCurrentConfiguration();
        await SyncDepthReferenceSourcesAsync();
    }

    private Task OnSelectedFieldIdChanged(Guid? fieldId)
    {
        Field? field = null;
        if (fieldId.HasValue && fieldId.Value != Guid.Empty && Fields != null)
        {
            Fields.TryGetValue(fieldId.Value, out field);
        }

        return OnSelectedFieldChanged(field);
    }

    private async Task OnSelectedClusterChanged(Cluster? cluster)
    {
        _selectedCluster = cluster;
        _resolvedCluster = cluster;
        _resolvedRig = null;
        _selectedWell = null;
        _selectedWellBore = null;

        if (cluster != null)
        {
            ApplyClusterReferenceValues(cluster);
            EnsureSurfaceSectionsForCurrentConfiguration();
            EnsureFluidsForCurrentConfiguration();
            await ResolveRigAsync();
        }

        await SyncDepthReferenceSourcesAsync();
        return;
    }

    private Task OnSelectedClusterIdChanged(Guid? clusterId)
    {
        Cluster? cluster = null;
        if (clusterId.HasValue && clusterId.Value != Guid.Empty && Clusters != null)
        {
            Clusters.TryGetValue(clusterId.Value, out cluster);
        }

        return OnSelectedClusterChanged(cluster);
    }

    private async Task OnSelectedWellChanged(Well? well)
    {
        _selectedWell = well;
        _selectedWellBore = null;
        _resolvedCluster = null;
        _resolvedRig = null;

        if (well?.ClusterID != null && well.ClusterID != Guid.Empty && Clusters != null && Clusters.TryGetValue(well.ClusterID.Value, out var cluster))
        {
            _resolvedCluster = cluster;
            if (!cluster.IsSingleWell)
            {
                _selectedCluster = cluster;
            }

            ApplyClusterReferenceValues(cluster);

            if (cluster.FieldID != null && cluster.FieldID != Guid.Empty && Fields != null && Fields.TryGetValue(cluster.FieldID.Value, out var field))
            {
                _selectedField = field;
            }
        }

        EnsureSurfaceSectionsForCurrentConfiguration();
        EnsureFluidsForCurrentConfiguration();
        await ResolveRigAsync();
        await SyncDepthReferenceSourcesAsync();
        return;
    }

    private Task OnSelectedWellIdChanged(Guid? wellId)
    {
        Well? well = null;
        if (wellId.HasValue && wellId.Value != Guid.Empty && Wells != null)
        {
            Wells.TryGetValue(wellId.Value, out well);
        }

        return OnSelectedWellChanged(well);
    }

