@inject ILogger<WellBoreArchitectureMain> logger
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IWellBoreArchitectureAPIUtils Api

@if (WellBoreArchitecture != null)
{
    <MudText Typo="Typo.h6"><b>@PanelTitle</b></MudText>
    <MudToolBar Class="px-0">
        <MudButton Variant="@(EditorMode == ArchitectureEditorMode.Simplified ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Primary"
                   OnClick="@(() => SetEditorMode(ArchitectureEditorMode.Simplified))">
            Simplified
        </MudButton>
        <MudButton Class="ml-2"
                   Variant="@(EditorMode == ArchitectureEditorMode.Detailed ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Primary"
                   OnClick="@(() => SetEditorMode(ArchitectureEditorMode.Detailed))">
            Detailed
        </MudButton>
        <MudSpacer />
        <MudButton IconColor="@Color.Primary" StartIcon="@Icons.Material.Filled.Save" Size="@Size.Medium" OnClick="@SaveWellBoreArchitecture">@PrimaryActionText</MudButton>
        <MudButton IconColor="@Color.Primary" StartIcon="@CancelIcon" Size="@Size.Medium" OnClick="@CloseWellBoreArchitecture">@SecondaryActionText</MudButton>
    </MudToolBar>

    <MudGrid Class="mt-2">
    @if (EditorMode == ArchitectureEditorMode.Detailed)
    {
        <MudItem xs="12" md="8">
        @if (IsEditMode)
        {
            <MudPaper Class="py-2 px-4 mb-4">
                <MudGrid Class="my-2">
                    <InputHeader xs="3" Text="Creation date" />
                    <InputHeader xs="3" Text="Last modification date" />
                </MudGrid>
                <MudGrid Class="my-2">
                    <MudItem xs="3">
                        <MudText Typo="Typo.body1">@WellBoreArchitecture.CreationDate</MudText>
                    </MudItem>
                    <MudItem xs="3">
                        <MudText Typo="Typo.body1">@WellBoreArchitecture.LastModificationDate</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudPaper Class="py-2 px-4">
            @RenderNamingSection()
        </MudPaper>
        <DetailedEdit WellBoreArchitectureInstance="WellBoreArchitecture" ValueChanged="@OnDetailedEditChanged" />
        @*
        @if (WellBoreArchitecture.WellHead != null)
        {
            <WellHeadEditor Class="py-2 px-4 mt-4" WellHead="@WellBoreArchitecture.WellHead" />
        }
        @if (WellBoreArchitecture.FluidsAboveGroundLevel != null)
        {
            <FluidPropertiesMain Class="py-2 px-4 mt-4" WellBoreArchitectureFluids="@WellBoreArchitecture.FluidsAboveGroundLevel" />
        }
        @if (WellBoreArchitecture.SurfaceSections != null)
        {
            <SurfaceSectionMain Class="py-2 px-4 mt-4" SurfaceSections="@WellBoreArchitecture.SurfaceSections" />
        }
        @if (WellBoreArchitecture.CasingSections != null)
        {
            <CasingSectionMain Class="py-2 px-4 mt-4" CasingSections="@WellBoreArchitecture.CasingSections" />
        }*@
        </MudItem>
    }
    else
    {
            <MudItem xs="12" md="8">
                <MudPaper Class="py-2 px-4 mb-4">
                    @RenderNamingSection()
                </MudPaper>

                @if (WellBoreArchitecture.WellHead != null)
                {
                    <WellHeadEditor Class="py-2 px-4 mb-4" WellHead="@WellBoreArchitecture.WellHead" />
                }

                <MudPaper Class="py-2 px-4 mb-4">
                    <MudText Typo="Typo.h6">Fluid properties above @MudLineLabel.ToLowerInvariant()</MudText>
                    <MudDivider Class="mb-2" />
                    @if (CurrentSurfaceConfiguration == SurfaceConfiguration.Onshore)
                    {
                        <MudGrid Class="my-2">
                            <InputHeader xs="4" Text="Fluid" />
                            <InputHeader xs="4" Text="Ground depth" />
                        </MudGrid>
                        <MudGrid Class="my-2">
                            <MudItem xs="4">
                                <MudText Typo="Typo.body2">Air</MudText>
                            </MudItem>
                            <MudItem xs="4">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DepthDrilling"
                                                           DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                           SIValueNullable="@GetGroundOrMudLineDepth()"
                                                           SIValueNullableChanged="@OnGroundOrMudLineDepthChanged" />
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        @if (CurrentSurfaceConfiguration == SurfaceConfiguration.OffshoreFixed)
                        {
                            <MudGrid Class="my-1">
                                <MudItem xs="12">
                                    <MudCheckBox T="bool"
                                                 Value="@_includeWaterAboveMudLine"
                                                 ValueChanged="@OnWaterAboveMudLineChanged"
                                                 Label="Include water above mud line"
                                                 Color="Color.Primary" />
                                </MudItem>
                            </MudGrid>
                        }

                        <MudGrid Class="my-2">
                            <InputHeader xs="4" Text="Mud line level" />
                            @if (ShouldShowWaterAboveMudLine)
                            {
                                <InputHeader xs="4" Text="Top of water depth" />
                            }
                        </MudGrid>
                        <MudGrid Class="my-2">
                            <MudItem xs="4">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DepthDrilling"
                                                           DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                           SIValueNullable="@GetGroundOrMudLineDepth()"
                                                           SIValueNullableChanged="@OnGroundOrMudLineDepthChanged" />
                            </MudItem>
                            @if (ShouldShowWaterAboveMudLine)
                            {
                                <MudItem xs="4">
                                    <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                               QuantityName="DepthDrilling"
                                                               DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                               SIValueNullable="@GetTopWaterDepth()"
                                                               SIValueNullableChanged="@OnTopWaterDepthChanged" />
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudPaper>

                <MudPaper Class="py-2 px-4 mb-4">
                    <MudText Typo="Typo.h6">Surface architecture</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-2">@SurfaceConfigurationDescription</MudText>
                    @if (IsFloatingRig)
                    {
                        <MudGrid Class="my-1">
                            <MudItem xs="12">
                                <MudCheckBox T="bool"
                                             Value="@_includeMarineRiser"
                                             ValueChanged="@OnMarineRiserToggleChanged"
                                             Label="Include marine riser"
                                             Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                        @if (!_includeMarineRiser)
                        {
                            <MudGrid Class="my-1">
                                <MudItem xs="12">
                                    <MudCheckBox T="bool"
                                                 Value="@_includeBop"
                                                 ValueChanged="@OnBopToggleChanged"
                                                 Label="Include BOP"
                                                 Color="Color.Primary" />
                                </MudItem>
                            </MudGrid>
                        }
                    }
                    <MudDivider Class="mb-2" />
                    <MudGrid Class="my-2">
                        <InputHeader xs="3" Text="Element" />
                        <InputHeader xs="3" Text="OD" />
                        <InputHeader xs="3" Text="ID" />
                        <InputHeader xs="3" Text="Length" />
                    </MudGrid>
                    @for (var i = 0; i < SurfaceSectionDescriptors.Count; i++)
                    {
                        var index = i;
                        var descriptor = SurfaceSectionDescriptors[i];
                        var section = GetSurfaceSectionAt(i);
                        var isBopRow = descriptor.Type == SurfaceSectionType.BOP;
                        @if (isBopRow)
                        {
                            <MudGrid Class="my-1">
                                <MudItem xs="3" />
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption"><b>Max OD</b></MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption"><b>Min ID</b></MudText>
                                </MudItem>
                                <MudItem xs="3">
                                    <MudText Typo="Typo.caption"><b>Height</b></MudText>
                                </MudItem>
                            </MudGrid>
                        }
                        <MudGrid Class="my-2">
                            <MudItem xs="3">
                                <MudText Typo="Typo.body2">@descriptor.Label</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DiameterPipeDrilling"
                                                           SIValueNullable="@GetGaussianValue(section.BodyOD)"
                                                           SIValueNullableChanged="value => UpdateSurfaceSectionOd(index, value)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DiameterPipeDrilling"
                                                           SIValueNullable="@GetGaussianValue(section.BodyID)"
                                                           SIValueNullableChanged="value => UpdateSurfaceSectionId(index, value)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DepthDrilling"
                                                           SIValueNullable="@GetGaussianValue(section.SectionLength)"
                                                           SIValueNullableChanged="value => UpdateSurfaceSectionLength(index, value)" />
                            </MudItem>
                        </MudGrid>
                        @if (descriptor.Type == SurfaceSectionType.LowPressureRiser || descriptor.Type == SurfaceSectionType.MarineRiser)
                        {
                            <MudGrid Class="my-1">
                                <MudItem xs="12">
                                    <MudCheckBox T="bool"
                                                 Value="@_includeBop"
                                                 ValueChanged="@OnBopToggleChanged"
                                                 Label="Include BOP"
                                                 Color="Color.Primary" />
                                </MudItem>
                            </MudGrid>
                        }
                        @if (ShouldRenderFloatingConnectorSectionAfter(descriptor.Type))
                        {
                            <MudGrid Class="my-2">
                                <InputHeader xs="4" Text="Choke line depth" />
                                <InputHeader xs="4" Text="Kill line depth" />
                                @if (ShouldShowBoosterLineDepth())
                                {
                                    <InputHeader xs="4" Text="Booster line depth" />
                                }
                            </MudGrid>
                            <MudGrid Class="my-2">
                                @if (_includeBop)
                                {
                                    <MudItem xs="4">
                                        <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                                   QuantityName="DepthDrilling"
                                                                   DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                                   SIValueNullable="@GetChokeLineDepth()"
                                                                   SIValueNullableChanged="@OnChokeLineDepthChanged" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                                   QuantityName="DepthDrilling"
                                                                   DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                                   SIValueNullable="@GetKillLineDepth()"
                                                                   SIValueNullableChanged="@OnKillLineDepthChanged" />
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="4" />
                                    <MudItem xs="4" />
                                }
                                @if (ShouldShowBoosterLineDepth())
                                {
                                    <MudItem xs="4">
                                        <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                                   QuantityName="DepthDrilling"
                                                                   DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                                   SIValueNullable="@GetBoosterLineDepth()"
                                                                   SIValueNullableChanged="@OnBoosterLineDepthChanged" />
                                    </MudItem>
                                }
                            </MudGrid>
                            @if (CanHostLiftPump())
                            {
                                <MudGrid Class="my-1">
                                    <MudItem xs="12">
                                        <MudCheckBox T="bool"
                                                     Value="@_includeLiftPump"
                                                     ValueChanged="@OnLiftPumpToggleChanged"
                                                     Label="Include lift pump"
                                                     Color="Color.Primary" />
                                    </MudItem>
                                </MudGrid>
                                @if (_includeLiftPump)
                                {
                                    <MudGrid Class="my-2">
                                        <InputHeader xs="4" Text="Lift pump depth" />
                                    </MudGrid>
                                    <MudGrid Class="my-2">
                                        <MudItem xs="4">
                                            <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                                       QuantityName="DepthDrilling"
                                                                       DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                                       SIValueNullable="@GetLiftPumpDepth()"
                                                                       SIValueNullableChanged="@OnLiftPumpDepthChanged" />
                                        </MudItem>
                                    </MudGrid>
                                }
                            }
                        }
                    }
                </MudPaper>

                <MudPaper Class="py-2 px-4 mb-4">
                    <MudToolBar Class="px-0">
                        <MudText Typo="Typo.h6">Downhole architecture</MudText>
                        <MudSpacer />
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="@Size.Small" OnClick="@AddCasingSection">Add row</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" Size="@Size.Small" OnClick="@CopyCasingSectionLine">Copy last</MudButton>
                        
                    </MudToolBar>
                    <MudDivider Class="mb-2" />
                    <div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:0.75rem;align-items:center;" class="my-2">
                        <MudText Typo="Typo.caption"><b>Suspension depth</b></MudText>
                        <MudText Typo="Typo.caption"><b>Final depth</b></MudText>
                        <MudText Typo="Typo.caption"><b>OD</b></MudText>
                        <MudText Typo="Typo.caption"><b>ID</b></MudText>
                        <MudText Typo="Typo.caption"><b>Borehole OD</b></MudText>
                        <MudText Typo="Typo.caption"><b>Cement</b></MudText>
                        <MudText Typo="Typo.caption"><b>Actions</b></MudText>
                    </div>
                    @for (var i = 0; i < SimplifiedCasingRows.Count; i++)
                    {
                        var index = i;
                        var row = SimplifiedCasingRows[i];
                        <div style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:0.75rem;align-items:center;" class="my-2">
                            <div>
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DepthDrilling"
                                                           DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                           SIValueNullable="@row.SuspensionDepth"
                                                           SIValueNullableChanged="value => UpdateCasingSuspensionDepth(index, value)" />
                            </div>
                            <div>
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DepthDrilling"
                                                           DrillingSignalReference="@DrillingSignalReferenceType.Depth"
                                                           SIValueNullable="@row.FinalDepth"
                                                           SIValueNullableChanged="value => UpdateCasingFinalDepth(index, value)" />
                            </div>
                            <div>
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DiameterPipeDrilling"
                                                           SIValueNullable="@row.OD"
                                                           SIValueNullableChanged="value => UpdateCasingOd(index, value)" />
                            </div>
                            <div>
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DiameterPipeDrilling"
                                                           SIValueNullable="@row.ID"
                                                           SIValueNullableChanged="value => UpdateCasingId(index, value)" />
                            </div>
                            <div>
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DiameterPipeDrilling"
                                                           SIValueNullable="@row.BoreholeOD"
                                                           SIValueNullableChanged="value => UpdateCasingBoreholeOd(index, value)" />
                            </div>
                            <div>
                                <MudCheckBox T="bool"
                                             Value="@row.HasCement"
                                             ValueChanged="value => UpdateCasingCement(index, value)"
                                             Color="Color.Primary" />
                            </div>
                            <div>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(index == 0)" OnClick="@(() => MoveCasingSection(index, -1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="@(index == SimplifiedCasingRows.Count - 1)" OnClick="@(() => MoveCasingSection(index, 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="@(SimplifiedCasingRows.Count == 1)" OnClick="@(() => RemoveCasingSection(index))" />
                            </div>
                        </div>
                    }
                </MudPaper>

                <MudPaper Class="py-2 px-4 mb-4">
                    <MudToolBar Class="px-0">
                        <MudText Typo="Typo.h6">Open hole section</MudText>
                        <MudSpacer />
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="@Size.Small" OnClick="@AddOpenHoleRow">Add row</MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" Size="@Size.Small" OnClick="@CopyOpenHole">Copy last</MudButton>

                    </MudToolBar>
                    <MudDivider Class="mb-2" />
                    <MudGrid Class="my-2">
                        <InputHeader xs="4" Text="OD" />
                        <InputHeader xs="4" Text="Length" />
                        <InputHeader xs="4" Text="Actions" />
                    </MudGrid>
                    @for (var i = 0; i < OpenHoleRows.Count; i++)
                    {
                        var index = i;
                        var row = OpenHoleRows[i];
                        <MudGrid Class="my-2">
                            <MudItem xs="4">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DiameterPipeDrilling"
                                                           SIValueNullable="@GetGaussianValue(row.HoleSize)"
                                                           SIValueNullableChanged="value => UpdateOpenHoleOd(index, value)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudInputWithUnitAdornment VariantType="Variant.Text"
                                                           QuantityName="DepthDrilling"
                                                           SIValueNullable="@GetGaussianValue(row.Length)"
                                                           SIValueNullableChanged="value => UpdateOpenHoleLength(index, value)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Disabled="@(index == 0)" OnClick="@(() => MoveOpenHoleRow(index, -1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Disabled="@(index == OpenHoleRows.Count - 1)" OnClick="@(() => MoveOpenHoleRow(index, 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Disabled="@(OpenHoleRows.Count == 1)" OnClick="@(() => RemoveOpenHoleRow(index))" />
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>
            </MudItem>
    }

            <MudItem xs="12" md="4">
                <MudPaper Class="py-2 px-4 mb-4" Style="position:sticky;top:1rem;">
                    <MudText Typo="Typo.h6">Schematic</MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-2">Not to scale. Relative diameters and lengths are preserved within each zone.</MudText>
                    <MudDivider Class="mb-2" />
                    <svg viewBox="0 0 320 900" style="width:100%;height:auto;background:#f5f5f5;border:1px solid #ddd;border-radius:8px;">
                        <defs>
                            <pattern id="rock-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
                                <line x1="0" y1="0" x2="0" y2="8" stroke="#8c7554" stroke-width="2" />
                            </pattern>
                            <pattern id="water-waves" width="24" height="12" patternUnits="userSpaceOnUse">
                                <path d="M0 8 C4 2, 8 2, 12 8 S20 14, 24 8" fill="none" stroke="#4f9ea8" stroke-width="1.4" />
                            </pattern>
                        </defs>
                        <rect x="0" y="0" width="320" height="900" fill="#dbeefe" />
                        @if (ShouldShowWaterAboveMudLine)
                        {
                            <rect x="0" y="112" width="320" height="113" fill="#8fc7c3" />
                            <rect x="0" y="112" width="320" height="113" fill="url(#water-waves)" opacity="0.45" />
                            <line x1="0" y1="112" x2="320" y2="112" stroke="#1f7ea0" stroke-width="2.5" />
                        }
                        <rect x="0" y="225" width="320" height="675" fill="#c6aa7d" />
                        <rect x="0" y="225" width="320" height="675" fill="url(#rock-hatch)" opacity="0.55" />

                        <line x1="120" y1="@Svg(DrillFloorY)" x2="200" y2="@Svg(DrillFloorY)" stroke="#111" stroke-width="8" stroke-linecap="round" />
                        <line x1="92" y1="@Svg(DrillFloorY)" x2="120" y2="@Svg(DrillFloorY)" stroke="#111" stroke-width="1.5" stroke-dasharray="5 4" />

                        <line x1="133.33" y1="@Svg(DrillFloorY)" x2="146.66" y2="@Svg(DerrickTopY)" stroke="#666" stroke-width="2.2" />
                        <line x1="186.67" y1="@Svg(DrillFloorY)" x2="173.34" y2="@Svg(DerrickTopY)" stroke="#666" stroke-width="2.2" />
                        <line x1="133.33" y1="@Svg(DrillFloorY)" x2="186.67" y2="@Svg(DrillFloorY)" stroke="#666" stroke-width="2.2" />
                        <line x1="138.33" y1="@Svg(DerrickFirstFloorY)" x2="181.67" y2="@Svg(DerrickFirstFloorY)" stroke="#666" stroke-width="1.8" />
                        <line x1="141.67" y1="@Svg(DerrickSecondFloorY)" x2="178.33" y2="@Svg(DerrickSecondFloorY)" stroke="#666" stroke-width="1.8" />
                        <line x1="145" y1="@Svg(DerrickThirdFloorY)" x2="175" y2="@Svg(DerrickThirdFloorY)" stroke="#666" stroke-width="1.8" />
                        <line x1="146.66" y1="@Svg(DerrickTopY)" x2="173.34" y2="@Svg(DerrickTopY)" stroke="#666" stroke-width="1.8" />
                        <line x1="133.33" y1="@Svg(DrillFloorY)" x2="181.67" y2="@Svg(DerrickFirstFloorY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="186.67" y1="@Svg(DrillFloorY)" x2="138.33" y2="@Svg(DerrickFirstFloorY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="138.33" y1="@Svg(DerrickFirstFloorY)" x2="178.33" y2="@Svg(DerrickSecondFloorY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="181.67" y1="@Svg(DerrickFirstFloorY)" x2="141.67" y2="@Svg(DerrickSecondFloorY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="141.67" y1="@Svg(DerrickSecondFloorY)" x2="175" y2="@Svg(DerrickThirdFloorY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="178.33" y1="@Svg(DerrickSecondFloorY)" x2="145" y2="@Svg(DerrickThirdFloorY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="145" y1="@Svg(DerrickThirdFloorY)" x2="173.34" y2="@Svg(DerrickTopY)" stroke="#7a7a7a" stroke-width="1.7" />
                        <line x1="175" y1="@Svg(DerrickThirdFloorY)" x2="146.66" y2="@Svg(DerrickTopY)" stroke="#7a7a7a" stroke-width="1.7" />

                        <line x1="160" y1="42" x2="160" y2="860" stroke="#222" stroke-width="2" stroke-dasharray="3 5" />
                        <line x1="@Svg(WellHeadLeftOuterX)" y1="@Svg(WellHeadTopY)" x2="@Svg(WellHeadLeftInnerX)" y2="@Svg(WellHeadTopY)" stroke="#1e5bb8" stroke-width="@Svg(WellHeadSymbolStrokeWidth)" stroke-linecap="square" />
                        <line x1="@Svg(WellHeadLeftInnerX)" y1="@Svg(WellHeadTopY)" x2="@Svg(WellHeadLeftInnerX)" y2="@Svg(WellHeadBottomY)" stroke="#1e5bb8" stroke-width="@Svg(WellHeadSymbolStrokeWidth)" stroke-linecap="square" />
                        <line x1="@Svg(WellHeadRightInnerX)" y1="@Svg(WellHeadTopY)" x2="@Svg(WellHeadRightOuterX)" y2="@Svg(WellHeadTopY)" stroke="#1e5bb8" stroke-width="@Svg(WellHeadSymbolStrokeWidth)" stroke-linecap="square" />
                        <line x1="@Svg(WellHeadRightInnerX)" y1="@Svg(WellHeadTopY)" x2="@Svg(WellHeadRightInnerX)" y2="@Svg(WellHeadBottomY)" stroke="#1e5bb8" stroke-width="@Svg(WellHeadSymbolStrokeWidth)" stroke-linecap="square" />
                        @if (ShouldShowWaterAboveMudLine)
                        {
                            <line x1="0" y1="112" x2="320" y2="112" stroke="#f7fbff" stroke-width="0.7" stroke-dasharray="6 4" />
                            <svg:text x="16" y="106" font-size="12" fill="#0f4f7d">Top of water: @TopWaterDepthDisplayText</svg:text>
                        }
                        <line x1="0" y1="@MudLineY" x2="320" y2="@MudLineY" stroke="#b08935" stroke-width="3" />
                        <svg:text x="16" y="@(MudLineY - 7)" font-size="13" fill="#6d4c41">@MudLineLabel: @MudLineDepthDisplayText</svg:text>
                        <svg:text x="16" y="246" font-size="12" fill="#7a5b36">Formation rock</svg:text>

                        @foreach (var equipment in SchematicEquipment)
                        {
                            @if (equipment.IsBop)
                            {
                                var connectorHeight = equipment.Height * 0.12;
                                var annularHeight = equipment.Height * 0.24;
                                var taperHeight = equipment.Height * 0.12;
                                var ramHeight = equipment.Height * 0.14;
                                var gapHeight = equipment.Height * 0.05;
                                var bodyX = equipment.X + equipment.Width * 0.18;
                                var bodyWidth = equipment.Width * 0.64;
                                var ramX = equipment.X;
                                var ramWidth = equipment.Width;
                                var neckX = equipment.X + equipment.Width * 0.28;
                                var neckWidth = equipment.Width * 0.44;
                                var y0 = equipment.Y;
                                var y1 = y0 + connectorHeight;
                                var y2 = y1 + annularHeight;
                                var y3 = y2 + taperHeight;
                                var y4 = y3 + ramHeight;
                                var y5 = y4 + gapHeight;
                                var y6 = y5 + ramHeight;
                                var y7 = y6 + gapHeight;
                                var y8 = y7 + ramHeight;
                                var y9 = y8 + gapHeight;
                                <rect x="@Svg(neckX)" y="@Svg(y0)" width="@Svg(neckWidth)" height="@Svg(connectorHeight)" fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(bodyX)" y="@Svg(y0)" width="@Svg(bodyWidth)" height="@Svg(connectorHeight)" fill="rgba(255,255,255,0.28)" />
                                <rect x="@Svg(ramX)" y="@Svg(y1)" width="@Svg(ramWidth)" height="@Svg(annularHeight)" fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(bodyX)" y="@Svg(y1)" width="@Svg(bodyWidth)" height="@Svg(annularHeight)" fill="rgba(255,255,255,0.22)" />
                                <polygon points="@($"{Svg(equipment.X + equipment.Width * 0.18)},{Svg(y2)} {Svg(equipment.X + equipment.Width * 0.82)},{Svg(y2)} {Svg(equipment.X + equipment.Width * 0.68)},{Svg(y3)} {Svg(equipment.X + equipment.Width * 0.32)},{Svg(y3)}")"
                                         fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(ramX)" y="@Svg(y3)" width="@Svg(ramWidth)" height="@Svg(ramHeight)" fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(ramX)" y="@Svg(y5)" width="@Svg(ramWidth)" height="@Svg(ramHeight)" fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(ramX)" y="@Svg(y7)" width="@Svg(ramWidth)" height="@Svg(ramHeight)" fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(bodyX)" y="@Svg(y3)" width="@Svg(bodyWidth)" height="@Svg(ramHeight)" fill="rgba(255,255,255,0.22)" />
                                <rect x="@Svg(bodyX)" y="@Svg(y5)" width="@Svg(bodyWidth)" height="@Svg(ramHeight)" fill="rgba(255,255,255,0.22)" />
                                <rect x="@Svg(bodyX)" y="@Svg(y7)" width="@Svg(bodyWidth)" height="@Svg(ramHeight)" fill="rgba(255,255,255,0.22)" />
                                <rect x="@Svg(neckX)" y="@Svg(y9)" width="@Svg(neckWidth)" height="@Svg(connectorHeight)" fill="#ef2f2f" stroke="#981b1b" stroke-width="1.2" />
                                <rect x="@Svg(bodyX)" y="@Svg(y9)" width="@Svg(bodyWidth)" height="@Svg(connectorHeight)" fill="rgba(255,255,255,0.28)" />
                            }
                            else
                            {
                                <rect x="@Svg(equipment.X)" y="@Svg(equipment.Y)" width="@Svg(equipment.Width)" height="@Svg(equipment.Height)" rx="3" fill="@equipment.Fill" stroke="@equipment.Stroke" stroke-width="1.5" />
                            }
                            <svg:text x="@Svg(equipment.X + equipment.Width + 8)" y="@Svg(equipment.Y + equipment.Height - 2)" font-size="11" fill="#222">@equipment.Label</svg:text>
                        }

                        @for (var boreHoleIndex = 0; boreHoleIndex < SchematicBoreHoleSegments.Count; boreHoleIndex++)
                        {
                            var boreHoleSegment = SchematicBoreHoleSegments[boreHoleIndex];
                            var leftPoints = BuildJaggedOpenHolePointList(boreHoleSegment.CenterX - boreHoleSegment.Width / 2.0, boreHoleSegment.TopY, boreHoleSegment.BottomY, true);
                            var rightPoints = BuildJaggedOpenHolePointList(boreHoleSegment.CenterX + boreHoleSegment.Width / 2.0, boreHoleSegment.TopY, boreHoleSegment.BottomY, false);
                            var leftPointString = string.Join(" ", leftPoints.Select(point => $"{Svg(point.X)},{Svg(point.Y)}"));
                            var rightPointString = string.Join(" ", rightPoints.Select(point => $"{Svg(point.X)},{Svg(point.Y)}"));
                            var boreHolePolygonPoints = string.Join(" ", leftPoints.Concat(rightPoints.AsEnumerable().Reverse()).Select(point => $"{Svg(point.X)},{Svg(point.Y)}"));
                            var clipId = $"borehole-clip-{boreHoleIndex}";
                            var leftAnnotationX = boreHoleSegment.CenterX - boreHoleSegment.Width / 2.0 - 8;
                            <defs>
                                <clipPath id="@clipId">
                                    <polygon points="@boreHolePolygonPoints" />
                                </clipPath>
                            </defs>
                            <polygon points="@boreHolePolygonPoints" fill="#e4e4e4" stroke="none" opacity="0.95" />
                            @if (boreHoleSegment.CementTopY.HasValue)
                            {
                                <rect x="@Svg(boreHoleSegment.CenterX - boreHoleSegment.Width / 2.0)"
                                      y="@Svg(boreHoleSegment.CementTopY.Value)"
                                      width="@Svg(boreHoleSegment.Width)"
                                      height="@Svg(Math.Max(0.0, boreHoleSegment.BottomY - boreHoleSegment.CementTopY.Value))"
                                      fill="#b0b0b0"
                                      clip-path="@($"url(#{clipId})")"
                                      opacity="0.9" />
                                <svg:text x="@Svg(leftAnnotationX)"
                                          y="@Svg(Math.Max(boreHoleSegment.TopY + 12.0, boreHoleSegment.CementTopY.Value + 2.0))"
                                          font-size="10"
                                          text-anchor="end"
                                          fill="#444">@boreHoleSegment.TocDepthAnnotation</svg:text>
                            }
                            <polyline points="@leftPointString" fill="none" stroke="#8c8c8c" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="square" />
                            <polyline points="@rightPointString" fill="none" stroke="#8c8c8c" stroke-width="1.4" stroke-linejoin="miter" stroke-linecap="square" />
                            <line x1="@Svg(boreHoleSegment.CenterX - boreHoleSegment.Width / 2.0)" y1="@Svg(boreHoleSegment.TopY)" x2="@Svg(boreHoleSegment.CenterX + boreHoleSegment.Width / 2.0)" y2="@Svg(boreHoleSegment.TopY)" stroke="#a0a0a0" stroke-width="1.1" />
                            <line x1="@Svg(boreHoleSegment.CenterX - boreHoleSegment.Width / 2.0)" y1="@Svg(boreHoleSegment.BottomY)" x2="@Svg(boreHoleSegment.CenterX + boreHoleSegment.Width / 2.0)" y2="@Svg(boreHoleSegment.BottomY)" stroke="#a0a0a0" stroke-width="1.1" />
                            <svg:text x="@Svg(leftAnnotationX)"
                                      y="@Svg(boreHoleSegment.BottomY - 14)"
                                      font-size="10"
                                      text-anchor="end"
                                      fill="#444">
                                <tspan x="@Svg(leftAnnotationX)" dy="0">@boreHoleSegment.DepthAnnotation</tspan>
                                <tspan x="@Svg(leftAnnotationX)" dy="11">@boreHoleSegment.DiameterAnnotation</tspan>
                            </svg:text>
                        }

                        @foreach (var casingString in SchematicCasingStrings)
                        {
                            var firstSegment = casingString.Segments.FirstOrDefault();
                            var lastSegment = casingString.Segments.LastOrDefault();
                            if (firstSegment == null || lastSegment == null)
                            {
                                continue;
                            }

                            for (var i = 0; i < casingString.Segments.Count; i++)
                            {
                                var segment = casingString.Segments[i];
                                var wallThickness = Math.Max(3.0, Math.Min(6.0, (segment.OuterWidth - segment.InnerWidth) / 2.0));
                                var leftWallX = segment.X;
                                var rightWallX = segment.X + segment.OuterWidth - wallThickness;
                                var innerX = segment.X + wallThickness;
                                var innerWidth = Math.Max(2.0, segment.OuterWidth - wallThickness * 2.0);
                                var segmentHeight = Math.Max(8.0, segment.BottomY - segment.TopY);

                                <rect x="@Svg(innerX)"
                                      y="@Svg(segment.TopY)"
                                      width="@Svg(innerWidth)"
                                      height="@Svg(segmentHeight)"
                                      fill="#fbfbfb" />
                                <rect x="@Svg(leftWallX)"
                                      y="@Svg(segment.TopY)"
                                      width="@Svg(wallThickness)"
                                      height="@Svg(segmentHeight)"
                                      fill="#111" />
                                <rect x="@Svg(rightWallX)"
                                      y="@Svg(segment.TopY)"
                                      width="@Svg(wallThickness)"
                                      height="@Svg(segmentHeight)"
                                      fill="#111" />

                                @if (i > 0)
                                {
                                    var previousSegment = casingString.Segments[i - 1];
                                    var previousWallThickness = Math.Max(3.0, Math.Min(6.0, (previousSegment.OuterWidth - previousSegment.InnerWidth) / 2.0));
                                    var previousRightWallX = previousSegment.X + previousSegment.OuterWidth - previousWallThickness;
                                    var previousInnerX = previousSegment.X + previousWallThickness;
                                    var previousInnerWidth = Math.Max(2.0, previousSegment.OuterWidth - previousWallThickness * 2.0);
                                    var previousInnerRightX = previousInnerX + previousInnerWidth;
                                    var currentInnerRightX = innerX + innerWidth;
                                    var bridgeY = segment.TopY - wallThickness / 2.0;
                                    var leftBridgeX = Math.Min(previousSegment.X, segment.X);
                                    var leftBridgeWidth = Math.Abs(segment.X - previousSegment.X) + wallThickness;
                                    var rightBridgeX = Math.Min(previousRightWallX, rightWallX);
                                    var rightBridgeWidth = Math.Abs(rightWallX - previousRightWallX) + wallThickness;
                                    var innerBridgeHeight = Math.Max(1.4, Math.Min(previousWallThickness, wallThickness));

                                    <rect x="@Svg(leftBridgeX)"
                                          y="@Svg(bridgeY)"
                                          width="@Svg(leftBridgeWidth)"
                                          height="@Svg(wallThickness)"
                                          fill="#111" />
                                    <rect x="@Svg(rightBridgeX)"
                                          y="@Svg(bridgeY)"
                                          width="@Svg(rightBridgeWidth)"
                                          height="@Svg(wallThickness)"
                                          fill="#111" />

                                    @if (Math.Abs(previousInnerX - innerX) > 0.01)
                                    {
                                        <rect x="@Svg(Math.Min(previousInnerX, innerX))"
                                              y="@Svg(segment.TopY - innerBridgeHeight / 2.0)"
                                              width="@Svg(Math.Abs(innerX - previousInnerX))"
                                              height="@Svg(innerBridgeHeight)"
                                              fill="#111" />
                                    }

                                    @if (Math.Abs(previousInnerRightX - currentInnerRightX) > 0.01)
                                    {
                                        <rect x="@Svg(Math.Min(previousInnerRightX, currentInnerRightX))"
                                              y="@Svg(segment.TopY - innerBridgeHeight / 2.0)"
                                              width="@Svg(Math.Abs(currentInnerRightX - previousInnerRightX))"
                                              height="@Svg(innerBridgeHeight)"
                                              fill="#111" />
                                    }
                                }
                            }

                            var firstWallThickness = Math.Max(3.0, Math.Min(6.0, (firstSegment.OuterWidth - firstSegment.InnerWidth) / 2.0));
                            var lastWallThickness = Math.Max(3.0, Math.Min(6.0, (lastSegment.OuterWidth - lastSegment.InnerWidth) / 2.0));
                            var shoeHeight = GetCasingShoeHeight(lastWallThickness);
                            var shoeWidth = GetCasingMarkerWidth(lastSegment.OuterWidth);
                            var hangerHeight = GetCasingMarkerHeight(firstWallThickness);
                            <rect x="@Svg(firstSegment.X - shoeWidth)"
                                  y="@Svg(firstSegment.TopY)"
                                  width="@Svg(shoeWidth)"
                                  height="@Svg(hangerHeight)"
                                  fill="#111" />
                            <rect x="@Svg(firstSegment.X + firstSegment.OuterWidth)"
                                  y="@Svg(firstSegment.TopY)"
                                  width="@Svg(shoeWidth)"
                                  height="@Svg(hangerHeight)"
                                  fill="#111" />

                            <polygon points="@($"{Svg(lastSegment.X - shoeWidth)},{Svg(lastSegment.BottomY)} {Svg(lastSegment.X)},{Svg(lastSegment.BottomY - shoeHeight)} {Svg(lastSegment.X)},{Svg(lastSegment.BottomY)}")"
                                     fill="#111" />
                            <polygon points="@($"{Svg(lastSegment.X + lastSegment.OuterWidth)},{Svg(lastSegment.BottomY - shoeHeight)} {Svg(lastSegment.X + lastSegment.OuterWidth + shoeWidth)},{Svg(lastSegment.BottomY)} {Svg(lastSegment.X + lastSegment.OuterWidth)},{Svg(lastSegment.BottomY)}")"
                                     fill="#111" />

                            @foreach (var segment in casingString.Segments)
                            {
                                <svg:text x="@Svg(segment.X + segment.OuterWidth + shoeWidth + 8)"
                                          y="@Svg(segment.BottomY - 14)"
                                          font-size="10"
                                          fill="#444">
                                    <tspan x="@Svg(segment.X + segment.OuterWidth + shoeWidth + 8)" dy="0">@segment.DepthAnnotation</tspan>
                                    <tspan x="@Svg(segment.X + segment.OuterWidth + shoeWidth + 8)" dy="11">@segment.DiameterAnnotation</tspan>
                                </svg:text>
                            }
                        }

                        @foreach (var openHoleSegment in SchematicOpenHoleSegments)
                        {
                            var leftPoints = BuildJaggedOpenHolePointList(openHoleSegment.CenterX - openHoleSegment.Width / 2.0, openHoleSegment.TopY, openHoleSegment.BottomY, true);
                            var rightPoints = BuildJaggedOpenHolePointList(openHoleSegment.CenterX + openHoleSegment.Width / 2.0, openHoleSegment.TopY, openHoleSegment.BottomY, false);
                            var leftPointString = string.Join(" ", leftPoints.Select(point => $"{Svg(point.X)},{Svg(point.Y)}"));
                            var rightPointString = string.Join(" ", rightPoints.Select(point => $"{Svg(point.X)},{Svg(point.Y)}"));
                            var openHolePolygonPoints = string.Join(" ", leftPoints.Concat(rightPoints.AsEnumerable().Reverse()).Select(point => $"{Svg(point.X)},{Svg(point.Y)}"));
                            <polygon points="@openHolePolygonPoints" fill="#fbfbfb" stroke="none" />
                            <polyline points="@leftPointString" fill="none" stroke="#2f2f2f" stroke-width="1.8" stroke-linejoin="miter" stroke-linecap="square" />
                            <polyline points="@rightPointString" fill="none" stroke="#2f2f2f" stroke-width="1.8" stroke-linejoin="miter" stroke-linecap="square" />
                            <line x1="@Svg(openHoleSegment.CenterX - openHoleSegment.Width / 2.0)" y1="@Svg(openHoleSegment.TopY)" x2="@Svg(openHoleSegment.CenterX + openHoleSegment.Width / 2.0)" y2="@Svg(openHoleSegment.TopY)" stroke="#2f2f2f" stroke-width="1.5" />
                            <line x1="@Svg(openHoleSegment.CenterX - openHoleSegment.Width / 2.0)" y1="@Svg(openHoleSegment.BottomY)" x2="@Svg(openHoleSegment.CenterX + openHoleSegment.Width / 2.0)" y2="@Svg(openHoleSegment.BottomY)" stroke="#2f2f2f" stroke-width="1.5" />
                            <svg:text x="@Svg(openHoleSegment.CenterX + openHoleSegment.Width / 2.0 + 8)"
                                      y="@Svg(openHoleSegment.BottomY - 14)"
                                      font-size="10"
                                      fill="#444">
                                <tspan x="@Svg(openHoleSegment.CenterX + openHoleSegment.Width / 2.0 + 8)" dy="0">@openHoleSegment.DepthAnnotation</tspan>
                                <tspan x="@Svg(openHoleSegment.CenterX + openHoleSegment.Width / 2.0 + 8)" dy="11">@openHoleSegment.DiameterAnnotation</tspan>
                            </svg:text>
                        }

                        @foreach (var segment in SchematicTubes)
                        {
                            <rect x="@Svg(segment.X)" y="@Svg(segment.Y)" width="@Svg(segment.OuterWidth)" height="@Svg(segment.Height)" fill="@segment.Fill" stroke="@segment.Stroke" stroke-width="1.2" />
                            @if (segment.InnerWidth > 2)
                            {
                                <rect x="@Svg(segment.X + (segment.OuterWidth - segment.InnerWidth) / 2.0)"
                                      y="@Svg(segment.Y)"
                                      width="@Svg(segment.InnerWidth)"
                                      height="@Svg(segment.Height)"
                                      fill="#fbfbfb"
                                      stroke="#d0d0d0"
                                      stroke-width="0.6" />
                            }
                            @if (segment.ShowShoulder)
                            {
                                <rect x="@Svg(segment.X - 4)" y="@Svg(segment.Y)" width="4" height="8" fill="#ffffff" stroke="#c0c0c0" stroke-width="0.8" />
                                <rect x="@Svg(segment.X + segment.OuterWidth)" y="@Svg(segment.Y)" width="4" height="8" fill="#ffffff" stroke="#c0c0c0" stroke-width="0.8" />
                            }
                            <svg:text x="18" y="@Svg(segment.Y + 14)" font-size="11" fill="#222">@segment.Label</svg:text>
                        }
                    </svg>
                </MudPaper>
            </MudItem>
        </MudGrid>

    <MudToolBar>
        <MudSpacer />
        <MudButton IconColor="@Color.Primary" StartIcon="@Icons.Material.Filled.Save" Size="@Size.Medium" OnClick="@SaveWellBoreArchitecture">@PrimaryActionText</MudButton>
        <MudButton IconColor="@Color.Primary" StartIcon="@CancelIcon" Size="@Size.Medium" OnClick="@CloseWellBoreArchitecture">@SecondaryActionText</MudButton>
    </MudToolBar>
}

@code {
    [CascadingParameter]
    private MudUnitAndReferenceChoiceTag? Parent { get; set; }

    [Parameter]
    public WellBoreArchitecture? WellBoreArchitecture { get; set; }

    [Parameter]
    public Dictionary<Guid, Field>? Fields { get; set; }

    [Parameter]
    public Dictionary<Guid, Cluster>? Clusters { get; set; }

    [Parameter]
    public Dictionary<Guid, Well>? Wells { get; set; }

    [Parameter]
    public Dictionary<Guid, RigLight>? Rigs { get; set; }

    [Parameter]
    public Dictionary<Guid, WellBore>? WellBores { get; set; }

    [Parameter]
    public Action? OnUpdate { get; set; }

    private ArchitectureEditorMode EditorMode { get; set; } = ArchitectureEditorMode.Simplified;

    private Field? _selectedField;
    private Cluster? _selectedCluster;
    private Cluster? _resolvedCluster;
    private Rig? _resolvedRig;
    private Well? _selectedWell;
    private WellBore? _selectedWellBore;
    private Guid? _initializedArchitectureId;
    private (double? GroundMudLine, double? SeaWaterLevel, double? WellHead, double? RotaryTable) _lastDepthReferenceSnapshot;
    private bool _hasDepthReferenceSnapshot;
    private List<SimplifiedCasingRow> _simplifiedCasingRows = new();
    private bool _includeBop = true;
    private bool _includeMarineRiser = true;
    private bool _includeLiftPump;
    private bool _includeWaterAboveMudLine = true;
    private const double CasingGroupingTolerance = 0.01;

    private bool IsEditMode => WellBoreArchitecture?.MetaInfo?.ID != null && WellBoreArchitecture.MetaInfo.ID != Guid.Empty;
    private string PanelTitle => IsEditMode ? "Wellbore Architecture Editor" : "Wellbore architecture";
    private string PrimaryActionText => IsEditMode ? "Save" : "Save and Close";
    private string SecondaryActionText => IsEditMode ? "Cancel" : "Close";
    private string CancelIcon => IsEditMode ? Icons.Material.Filled.Cancel : Icons.Material.Filled.Close;
    private SurfaceConfiguration CurrentSurfaceConfiguration => GetSurfaceConfiguration();
    private bool IsFloatingRig => CurrentSurfaceConfiguration == SurfaceConfiguration.OffshoreFloater;
    private string SurfaceConfigurationDescription => CurrentSurfaceConfiguration switch
    {
        SurfaceConfiguration.Onshore => "Onshore configuration inferred from the selected cluster.",
        SurfaceConfiguration.OffshoreFixed => "Offshore fixed-platform configuration inferred from the selected cluster.",
        SurfaceConfiguration.OffshoreFloater => "Offshore floater configuration inferred from the selected cluster.",
        _ => "Configuration is unknown. Using the onshore surface layout until a cluster/well is selected."
    };
    private string MudLineLabel => IsOffshoreConfiguration(CurrentSurfaceConfiguration) ? "Mud line" : "Ground level";
    private string MudLineDepthDisplayText => FormatDepthForDisplay(GetGroundOrMudLineDepth());
    private string TopWaterDepthDisplayText => FormatDepthForDisplay(GetTopWaterDepth());
    private const double MudLineY = 225.0;
    private const double WellHeadTopY = 228.0;
    private const double TopsideZoneTopY = 0.0;
    private const double TopsideZoneHeight = 225.0;
    private const double DerrickTopClearance = 18.0;
    private const double SurfaceBottomGap = 0.0;
    private double DrillFloorY => GetDrillFloorY();
    private double DerrickTopY => DrillFloorY - GetRigHeightPixels();
    private double DerrickFirstFloorY => DrillFloorY - GetRigHeightPixels() * 0.276;
    private double DerrickSecondFloorY => DrillFloorY - GetRigHeightPixels() * 0.552;
    private double DerrickThirdFloorY => DrillFloorY - GetRigHeightPixels() * 0.828;
    private double TopsideY => DrillFloorY;
    private double TopsideHeight => Math.Max(24.0, WellHeadTopY - TopsideY - SurfaceBottomGap);
    private double WellHeadSymbolStrokeWidth => GetRiserDisplayWidth(Math.Max(1.0, GetMaxDiameter()));
    private double WellHeadInnerGap => GetOuterMostCasingHangerWidth();
    private double WellHeadArmLength => Math.Max(18.0, WellHeadSymbolStrokeWidth * 1.55);
    private double WellHeadLegHeight => Math.Max(14.0, WellHeadSymbolStrokeWidth * 1.8);
    private double WellHeadLeftInnerX => 160.0 - WellHeadInnerGap / 2.0;
    private double WellHeadLeftOuterX => WellHeadLeftInnerX - WellHeadArmLength;
    private double WellHeadRightInnerX => 160.0 + WellHeadInnerGap / 2.0;
    private double WellHeadRightOuterX => WellHeadRightInnerX + WellHeadArmLength;
    private double WellHeadBottomY => WellHeadTopY + WellHeadLegHeight;

    private List<SurfaceSectionDescriptor> SurfaceSectionDescriptors => GetSurfaceSectionDescriptors(CurrentSurfaceConfiguration);
    private List<CasingSection> CasingSectionsList => EnsureCasingSectionsList();
    private List<SimplifiedCasingRow> SimplifiedCasingRows => EnsureSimplifiedCasingRows();
    private List<BoreHoleSize> OpenHoleRows => EnsureOpenHoleRows();
    private List<SchematicCasingString> SchematicCasingStrings => BuildSchematicCasingStrings();
    private List<SchematicBoreHoleSegment> SchematicBoreHoleSegments => BuildSchematicBoreHoleSegments();
    private List<SchematicOpenHoleSegment> SchematicOpenHoleSegments => BuildSchematicOpenHoleSegments();
    private List<SchematicTube> SchematicTubes => BuildSchematicTubes();
    private List<SchematicEquipmentBlock> SchematicEquipment => BuildSchematicEquipment();
    private IEqualityComparer<Field> FieldComparer { get; } = new MetaInfoIdComparer<Field>(item => item?.MetaInfo?.ID);
    private IEqualityComparer<Cluster> ClusterComparer { get; } = new MetaInfoIdComparer<Cluster>(item => item?.MetaInfo?.ID);
    private IEqualityComparer<Well> WellComparer { get; } = new MetaInfoIdComparer<Well>(item => item?.MetaInfo?.ID);
    private IEqualityComparer<WellBore> WellBoreComparer { get; } = new MetaInfoIdComparer<WellBore>(item => item?.MetaInfo?.ID);

    protected override bool ShouldRender() =>
        WellBoreArchitecture != null &&
        WellBoreArchitecture.WellHead != null &&
        WellBoreArchitecture.FluidsAboveGroundLevel != null &&
        WellBoreArchitecture.SurfaceSections != null &&
        WellBoreArchitecture.CasingSections != null;

    protected override async Task OnParametersSetAsync()
    {
        await InitializeArchitectureAsync();
        await SyncDepthReferenceSourcesAsync();
    }

    private void OnDetailedEditChanged(WellBoreArchitecture updated)
    {
        WellBoreArchitecture = updated;
        StateHasChanged();
    }

    private void SetEditorMode(ArchitectureEditorMode mode)
    {
        if (mode == ArchitectureEditorMode.Detailed)
        {
            ApplySimplifiedRowsToDetailedSections();
        }

        EditorMode = mode;
        if (mode == ArchitectureEditorMode.Simplified)
        {
            EnsureSurfaceSectionsForCurrentConfiguration();
            EnsureFluidsForCurrentConfiguration();
            _simplifiedCasingRows = BuildSimplifiedRowsFromDetailedSections();
            EnsureSimplifiedCasingRows();
        }
    }

    private RenderFragment RenderNamingSection() => @<div>
        <MudText Typo="Typo.h6">Naming section</MudText>
        <MudDivider Class="mb-2" />
        <MudGrid Class="my-2">
            <InputHeader xs="2" Text="Name" />
            <InputHeader xs="2" Text="Description" />
            <InputHeader xs="2" Text="Field" />
            <InputHeader xs="2" Text="Cluster" />
            <InputHeader xs="2" Text="Well" />
            <InputHeader xs="2" Text="Wellbore" />
        </MudGrid>
        <MudGrid Class="my-2">
            <MudItem xs="2">
                <MudTextField @bind-Value="WellBoreArchitecture!.Name" Variant="Variant.Text"></MudTextField>
            </MudItem>
            <MudItem xs="2">
                <MudTextField @bind-Value="WellBoreArchitecture!.Description" Variant="Variant.Text"></MudTextField>
            </MudItem>
            @if (Fields != null)
            {
                <MudItem xs="2">
                    <MudSelect T="Guid?" Value="@(_selectedField?.MetaInfo?.ID)" ValueChanged="@OnSelectedFieldIdChanged" Dense="true">
                        @foreach (var fieldKPV in Fields)
                        {
                            if (fieldKPV.Key != Guid.Empty && fieldKPV.Value != null && !string.IsNullOrEmpty(fieldKPV.Value.Name))
                            {
                                <MudSelectItem Value="@((Guid?)fieldKPV.Key)">@fieldKPV.Value.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="2" />
            }
            @if (Clusters != null && _selectedField != null)
            {
                <MudItem xs="2">
                    <MudSelect T="Guid?" Value="@(_selectedCluster?.MetaInfo?.ID)" ValueChanged="@OnSelectedClusterIdChanged" Dense="true">
                        @foreach (var clusterKVP in Clusters.Where(x => x.Value != null
                            && x.Value.FieldID != null
                            && _selectedField.MetaInfo != null
                            && _selectedField.MetaInfo.ID == x.Value.FieldID
                            && !x.Value.IsSingleWell))
                        {
                            <MudSelectItem Value="@((Guid?)clusterKVP.Key)">@clusterKVP.Value.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="2" />
            }
            @if (Wells != null)
            {
                <MudItem xs="2">
                    <MudSelect T="Guid?" Value="@(_selectedWell?.MetaInfo?.ID)" ValueChanged="@OnSelectedWellIdChanged" Dense="true">
                        @foreach (var wellKVP in Wells.Where(x => x.Value != null
                            && ((_selectedCluster != null
                                && _selectedCluster.MetaInfo != null
                                && x.Value.ClusterID != null
                                && _selectedCluster.MetaInfo.ID == x.Value.ClusterID
                                && !x.Value.IsSingleWell)
                                || x.Value.IsSingleWell)))
                        {
                            <MudSelectItem Value="@((Guid?)wellKVP.Key)">@wellKVP.Value.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="2" />
            }
            @if (WellBores != null && _selectedWell != null)
            {
                <MudItem xs="2">
                    <MudSelect T="Guid?" Value="@(_selectedWellBore?.MetaInfo?.ID)" ValueChanged="@OnSelectedWellBoreIdChanged" Dense="true">
                        @foreach (var wellBoreKVP in WellBores.Where(x => x.Value != null
                            && x.Value.WellID != null
                            && _selectedWell.MetaInfo != null
                            && _selectedWell.MetaInfo.ID == x.Value.WellID))
                        {
                            <MudSelectItem Value="@((Guid?)wellBoreKVP.Key)">@wellBoreKVP.Value.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else
            {
                <MudItem xs="2" />
            }
        </MudGrid>
    </div>;

    private async Task InitializeArchitectureAsync()
    {
        if (WellBoreArchitecture == null)
        {
            return;
        }

        EnsureDefaults();

        var currentArchitectureId = WellBoreArchitecture.MetaInfo?.ID;
        if (_initializedArchitectureId == currentArchitectureId && HasInitializedSelectionState())
        {
            return;
        }

        _initializedArchitectureId = currentArchitectureId;
        _selectedField = null;
        _selectedCluster = null;
        _resolvedCluster = null;
        _resolvedRig = null;
        _selectedWell = null;
        _selectedWellBore = null;
        _includeBop = WellBoreArchitecture.SurfaceSections?.Any(section => section.Type == SurfaceSectionType.BOP) ?? true;
        _includeMarineRiser = WellBoreArchitecture.SurfaceSections?.Any(section => section.Type == SurfaceSectionType.MarineRiser) ?? true;
        _includeLiftPump = HasNamedSideConnector(GetMarineRiserSection(), "LiftPump") || HasNamedSideConnector(GetBopSurfaceSection(), "LiftPump");
        _includeWaterAboveMudLine = WellBoreArchitecture.FluidsAboveGroundLevel?.Any(fluid => fluid.Fluid == FluidType.Water) ?? false;

        var wellBoreId = WellBoreArchitecture.WellBoreID;
        var wellBore = await ResolveWellBoreAsync(wellBoreId);
        if (wellBore == null)
        {
            EnsureSurfaceSectionsForCurrentConfiguration();
            EnsureFluidsForCurrentConfiguration();
            await ResolveRigAsync();
            return;
        }

        _selectedWellBore = wellBore;

        var well = await ResolveWellAsync(wellBore.WellID);
        if (well == null)
        {
            EnsureSurfaceSectionsForCurrentConfiguration();
            EnsureFluidsForCurrentConfiguration();
            await ResolveRigAsync();
            return;
        }

        _selectedWell = well;

        var cluster = await ResolveClusterAsync(well.ClusterID);
        if (cluster == null)
        {
            EnsureSurfaceSectionsForCurrentConfiguration();
            EnsureFluidsForCurrentConfiguration();
            await ResolveRigAsync();
            return;
        }

        _resolvedCluster = cluster;
        ApplyClusterReferenceValues(cluster);

        if (!cluster.IsSingleWell)
        {
            _selectedCluster = cluster;
        }

        var field = await ResolveFieldAsync(cluster.FieldID);
        if (field != null)
        {
            _selectedField = field;
        }

        EnsureSurfaceSectionsForCurrentConfiguration();
        EnsureFluidsForCurrentConfiguration();
        await ResolveRigAsync();
    }

    private async Task<WellBore?> ResolveWellBoreAsync(Guid? wellBoreId)
    {
        if (!wellBoreId.HasValue || wellBoreId == Guid.Empty)
        {
            return null;
        }

        if (WellBores != null && WellBores.TryGetValue(wellBoreId.Value, out var dictionaryWellBore) && dictionaryWellBore != null)
        {
            return dictionaryWellBore;
        }

        try
        {
            return await Api.ClientWellBore.GetWellBoreByIdAsync(wellBoreId.Value);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Impossible to resolve WellBore details for wellbore id {WellBoreId}", wellBoreId.Value);
            return null;
        }
    }

    private async Task<Well?> ResolveWellAsync(Guid? wellId)
    {
        if (!wellId.HasValue || wellId == Guid.Empty)
        {
            return null;
        }

        if (Wells != null && Wells.TryGetValue(wellId.Value, out var dictionaryWell) && dictionaryWell != null)
        {
            return dictionaryWell;
        }

        try
        {
            return await Api.ClientWell.GetWellByIdAsync(wellId.Value);
        }
        catch (Exception ex)
