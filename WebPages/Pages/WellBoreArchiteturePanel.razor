    private SurfaceSection? GetLiftPumpHostSection() =>
        _includeMarineRiser && IsFloatingRig
            ? GetMarineRiserSection()
            : GetBopSurfaceSection();

    private bool CanHostLiftPump() => IsFloatingRig && GetLiftPumpHostSection() != null;

    private bool ShouldShowBoosterLineDepth() => IsFloatingRig && _includeMarineRiser;

    private bool ShouldRenderFloatingConnectorSectionAfter(SurfaceSectionType descriptorType)
    {
        if (_includeBop && descriptorType == SurfaceSectionType.BOP)
        {
            return true;
        }

        return !_includeBop && IsFloatingRig && _includeMarineRiser && descriptorType == SurfaceSectionType.MarineRiser;
    }

    private void SyncLiftPumpConnector()
    {
        var marineRiserSection = GetMarineRiserSection();
        var bopSection = GetBopSurfaceSection();
        var existingDepth =
            ConversionsFromOSDC.GaussianToDouble(marineRiserSection?.SideConnectors?.FirstOrDefault(item => item?.FirstSideElement?.Name == "LiftPump")?.VerticalDepth) ??
            ConversionsFromOSDC.GaussianToDouble(bopSection?.SideConnectors?.FirstOrDefault(item => item?.FirstSideElement?.Name == "LiftPump")?.VerticalDepth);

        RemoveNamedSideConnector(marineRiserSection, "LiftPump");
        RemoveNamedSideConnector(bopSection, "LiftPump");

        if (!_includeLiftPump || !CanHostLiftPump())
        {
            return;
        }

        UpdateLiftPumpDepth(existingDepth);
    }

    private static bool IsOffshoreConfiguration(SurfaceConfiguration configuration) =>
        configuration == SurfaceConfiguration.OffshoreFixed || configuration == SurfaceConfiguration.OffshoreFloater;

    private static bool IsOffshoreCluster(Cluster cluster)
    {
        var topWaterDepth = cluster.TopWaterDepth?.GaussianValue?.Mean ?? 0.0;
        return topWaterDepth > 0.0;
    }

